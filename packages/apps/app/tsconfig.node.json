{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vite/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "../../shared/types/src/txn-registry.d.ts",
    // Main-process tests import the shared harness by relative path, and a
    // composite project must list every relatively-imported file.
    "../../shared/test-utils/ipc-harness.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
