{
  "name": "@slayzone/app",
  "version": "0.36.0",
  "private": true,
  "repository": "github:debuglebowski/slayzone",
  "type": "module",
  "main": "./out/main/bootstrap.js",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:protocol": "SLAYZONE_REGISTER_DEV_PROTOCOL=1 node dev.mjs",
    "prebuild": "pnpm --filter @slayzone/hub build && pnpm --filter @slayzone/computer build && pnpm --filter @slayzone/web-shell build",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "pnpm --filter @slayzone/cli build && npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:win:x64": "npm run build && electron-builder --win --x64",
    "build:win:arm64": "npm run build && electron-builder --win --arm64",
    "build:win:all": "npm run build && electron-builder --win --x64 --arm64",
    "build:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.web.json && tsgo --noEmit -p tsconfig.e2e.json",
    "test:agent-hooks": "vitest run --root ../../.. --config packages/apps/app/vitest.config.ts --exclude \"**/.claude/worktrees/**\" packages/apps/app/src/main/agent-hooks packages/shared/transport/src/server/http/rest-api/agent-hook.test.ts",
    "test:e2e": "bash e2e-parallel.sh",
    "test:e2e:serial": "npx playwright test --config playwright.config.ts",
    "test:e2e:headed": "npx playwright test --config playwright.config.ts --headed",
    "test:e2e:loop": "bash e2e-loop.sh",
    "test:e2e:loop:stop": "bash e2e-loop.sh --stop-on-fail",
    "test:e2e:parallel": "bash e2e-parallel.sh",
    "test:e2e:perf": "npx playwright test --config playwright.config.ts e2e/perf/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@trpc/server": "^11.19.0",
    "better-sqlite3": "^13.0.3",
    "bufferutil": "^4.1.0",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.10",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "zod": "^4.3.5"
  },
