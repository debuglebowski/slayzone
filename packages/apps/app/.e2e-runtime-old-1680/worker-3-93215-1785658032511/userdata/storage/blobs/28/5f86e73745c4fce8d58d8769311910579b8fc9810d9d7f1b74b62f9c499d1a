                    web["Static web server"]
                    api["API (Container App)"]
                end

                subgraph snetdb["Subnet: snet-db-normain"]
                    db[("DB — Managed PostgreSQL")]
                end

                subgraph snetvm["Subnet: snet-vm-normain"]
                    jump["Jump server (VM)"]
                end
            end
        end

        rgother["Additional resource groups (dev, demo)\nidentical internal setup per deployment"]
    end

    internet -- HTTPS --> lb
    lb -- HTTPS --> web
    lb -- HTTPS --> api
    api --> db
    admin -- RDP --> jump
    jump -. admin access .-> db
    jump -. admin access .-> api
