flowchart TB
    internet([Internet])
    admin([Admin / Operator])

    subgraph sub["Azure Subscription — region: Sweden Central"]
        direction TB

        subgraph rgprod["Resource Group: Production deployment"]
            direction TB
            subgraph vnet["Virtual network: vnet-normain"]
                direction TB

                subgraph snetapi["Subnet: snet-api-normain"]
