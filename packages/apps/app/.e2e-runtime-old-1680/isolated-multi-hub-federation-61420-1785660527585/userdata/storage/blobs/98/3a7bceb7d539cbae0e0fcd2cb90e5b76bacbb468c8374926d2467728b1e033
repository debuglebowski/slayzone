erDiagram
  %% ---- BetterAuth identity tier (text PKs) ----
  user ||--o{ session : user_id
  user ||--o{ account : user_id
  user ||--o{ member : user_id
  user ||--o{ invitation : inviter_id
  organization ||--o{ member : organization_id
  organization ||--o{ invitation : organization_id

  %% ---- Engine meta-schema tier (uuid PKs) ----
  concepts ||--o{ fields : concept_id
  concepts ||--o{ instances : concept_id
  instances ||--o{ relations : from_id
  instances ||--o{ relations : to_id
  instances ||--o{ attachments : instance_id

  %% ---- Cross-tier logical links (no DB constraint) ----
  organization ||..o{ concepts : "org_id (logical)"
  organization ||..o{ instances : "org_id (logical)"
  organization ||..o{ events : "org_id (logical)"
  user ||..o{ events : "actor (logical)"
  organization ||..o{ session : "active_org (logical)"

  user {
    text id PK
    text name
    text email UK
    bool email_verified
    text image
    timestamptz created_at
    timestamptz updated_at
  }
  session {
    text id PK
    text user_id FK
    text token UK
    timestamptz expires_at
    text active_organization_id "logical org"
    text ip_address
    text user_agent
  }
  account {
    text id PK
    text user_id FK
    text account_id
    text provider_id
    text password
    text access_token
    text refresh_token
    timestamptz created_at
  }
  verification {
    text id PK
    text identifier
    text value
    timestamptz expires_at
  }
  organization {
    text id PK
    text name
    text slug UK
    text logo
    text metadata
    timestamptz created_at
  }
  member {
    text id PK
    text organization_id FK
    text user_id FK
    text role
    timestamptz created_at
  }
  invitation {
    text id PK
    text organization_id FK
    text inviter_id FK
    text email
    text role
    text status
    timestamptz expires_at
  }

  concepts {
    uuid id PK
    text org_id FK "logical org"
    text slug UK
    text name UK
    text description
    timestamptz created_at
  }
  fields {
    uuid id PK
    text org_id FK
    uuid concept_id FK
    text name
    text kind
    text formula
    jsonb config
  }
  instances {
    uuid id PK
    text org_id FK
    uuid concept_id FK
    jsonb state
    bigint version
    timestamptz created_at
    timestamptz deleted_at
  }
  relations {
    uuid id PK
    text org_id FK
    text relation_type
    uuid from_id FK
    uuid to_id FK
    jsonb properties
    timestamptz created_at
    timestamptz deleted_at
  }
  events {
    bigserial id PK
    text org_id FK
    timestamptz occurred_at
    text actor "logical user"
    text subject_kind
    uuid subject_id
    text event_type
    jsonb payload
  }
  attachments {
    uuid id PK
    text org_id FK
    uuid instance_id FK
    text filename
    text content_ref
    text mime_type
    bigint size_bytes
    timestamptz created_at
  }
