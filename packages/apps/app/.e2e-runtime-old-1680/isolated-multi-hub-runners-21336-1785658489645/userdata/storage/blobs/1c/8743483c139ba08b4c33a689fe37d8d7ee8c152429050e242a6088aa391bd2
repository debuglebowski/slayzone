flowchart TD
    %% Player levers (actions)
    subgraph Actions["Player actions"]
        Marketing[Marketing spend]
        ResearchSpend[Research spend]
        Reliability[Reliability spend]
        BuyServer[Buy / sell servers]
        AllocCompute[Allocate compute]
        SetPrice[Set price]
        StartResearch[Start research]
        Publish[Publish model]
        VCRaise[Attempt VC raise]
        Positioning[Positioning]
        Certs[Certifications]
        Security[Security level]
        Privacy[Privacy level]
        Hack[Sabotage<br/>hack / dirt / tip]
        MA[M&A offers]
        Msg[Send message]
    end

    %% Internal state
    subgraph State["Player state"]
        Cash((Cash))
        Servers[Server inventory]
        InfCap[Inference capacity]
        ResCap[Research capacity]
        Brand[Brand]
        Quality[Published model<br/>quality]
        ResearchProg[Research progress]
        Burn[Burn rate]
        OpsLevels[Reliability /<br/>Security / Privacy /<br/>Certs]
    end

    %% Market
    subgraph Market["Market"]
        Demand[Demand share]
        Served[Demand served]
        Revenue[Revenue]
    end

    %% Situations
    Situations((Situations<br/>server-generated))

    %% Spend → burn
    Marketing --> Burn
    ResearchSpend --> Burn
    Reliability --> Burn

    %% Action → state
    BuyServer --> Servers
    AllocCompute --> InfCap
    AllocCompute --> ResCap
    Servers --> InfCap
    Servers --> ResCap
    StartResearch --> ResearchProg
    ResCap --> ResearchProg
    Publish --> Quality
    ResearchProg --> Quality
    Marketing --> Brand
    Positioning --> Brand
    VCRaise --> Cash

    %% Ops
    Reliability --> OpsLevels
    Certs --> OpsLevels
    Security --> OpsLevels
    Privacy --> OpsLevels

    %% Inter-player
    MA --> Cash
    Hack -.->|targets| OpsLevels
    Msg -.->|info| Brand

    %% Demand chain
    Brand --> Demand
    Quality --> Demand
    SetPrice --> Demand
    Demand --> Served
    InfCap --> Served
    Served --> Revenue
    Revenue --> Cash

    %% Burn
    Burn --> Cash
    Cash --> Bankruptcy{cash &lt; 0?}
    Bankruptcy -->|yes| Eliminated[Eliminated]

    %% Situations affect state
    Situations -.-> Brand
    Situations -.-> Demand
    Situations -.-> Cash
    Situations -.-> Quality
    Situations -.-> Servers

    %% Counters
    OpsLevels -.->|mitigate| Situations

    %% Win condition
    Cash --> Score[Final score]
    Brand --> Score
    Quality --> Score
