graph LR
  classDef spine fill:#1f2937,stroke:#9ca3af,color:#fff;
  classDef crm fill:#0e7490,stroke:#67e8f9,color:#fff;
  classDef comp fill:#b45309,stroke:#fcd34d,color:#fff;

  subgraph SPINE[Shared spine]
    A[Account]:::spine
    AC[AccountContact]:::spine
  end

  subgraph CRM[CRM docs]
    AN["AccountNote<br/>author: member"]:::crm
    MN["MeetingNote<br/>author: member"]:::crm
    PR["Proposal<br/>draft to sent to accepted"]:::crm
  end

  subgraph COMP[Compliance docs]
    TPL["AgreementTemplate<br/>doc_type: MSA/DPA/NDA/SOW<br/>owner: member<br/>draft to active to deprecated"]:::comp
    AG["Agreement (executed)<br/>owner: member<br/>draft to active to expired<br/>effective + expiry dates"]:::comp
    PO["Policy<br/>owner + approved_by: member<br/>review_due"]:::comp
    RB["Runbook<br/>owner: member<br/>review_due"]:::comp
  end

  AC -->|works_at| A
  AN -->|about| A
  MN -->|about| A
  MN -->|with| AC
  PR -->|for| A
  AG -->|based_on| TPL
  AG -->|for| A
  AG -->|signed_by| AC
