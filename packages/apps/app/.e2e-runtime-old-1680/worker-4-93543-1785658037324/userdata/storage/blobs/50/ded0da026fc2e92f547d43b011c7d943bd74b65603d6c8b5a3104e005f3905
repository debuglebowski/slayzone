const css = v => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
const C = { blue: css('--blue'), green: css('--green'), orange: css('--orange'), red: css('--red'), purple: css('--purple'), cyan: css('--cyan'), muted: css('--muted'), border: css('--border'), text: css('--text') };

Chart.defaults.animation = false;
Chart.defaults.color = C.muted;
Chart.defaults.borderColor = 'rgba(48,54,61,.6)';
Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
Chart.defaults.plugins.legend.labels.boxWidth = 12;
Chart.defaults.plugins.legend.labels.boxHeight = 12;

// ---- aggregate ----
const months = [...new Set(DATA.map(c => c.m))].sort();
const byMonth = Object.fromEntries(months.map(m => [m, DATA.filter(c => c.m === m)]));
const sum = (a, f) => a.reduce((s, x) => s + f(x), 0);
const avg = (a, f) => a.length ? sum(a, f) / a.length : 0;

const mCount = months.map(m => byMonth[m].length);
const mHours = months.map(m => +sum(byMonth[m], c => c.hrs).toFixed(1));
const mCx = months.map(m => +avg(byMonth[m], c => c.cx).toFixed(2));
const mEff = months.map(m => +avg(byMonth[m], c => c.eff).toFixed(2));
const mTh = months.map(m => +avg(byMonth[m], c => c.th).toFixed(2));

const totalHours = sum(DATA, c => c.hrs);

// KPIs
const kpis = [
  [DATA.length.toLocaleString(), 'commits'],
  [Math.round(totalHours).toLocaleString(), 'est. human-hours'],
  [avg(DATA, c => c.cx).toFixed(1), 'avg complexity'],
  [avg(DATA, c => c.th).toFixed(1), 'avg thought'],
  [(totalHours / DATA.length).toFixed(1), 'avg hrs / commit'],
];
document.getElementById('kpis').innerHTML = kpis.map(([v, l]) => `<div class="kpi"><div class="v">${v}</div><div class="l">${l}</div></div>`).join('');

// 1. monthly bars + hours line
new Chart(cMonthly, {
  data: {
    labels: months,
    datasets: [
      { type: 'bar', label: 'Commits', data: mCount, backgroundColor: 'rgba(88,166,255,.55)', borderColor: C.blue, borderWidth: 1, yAxisID: 'y' },
      { type: 'line', label: 'Est. hours', data: mHours, borderColor: C.orange, backgroundColor: C.orange, tension: .3, yAxisID: 'y2', pointRadius: 3 },
    ],
  },
  options: {
    maintainAspectRatio: false,
    scales: {
      y: { title: { display: true, text: 'commits' }, beginAtZero: true },
      y2: { position: 'right', title: { display: true, text: 'est. hours' }, beginAtZero: true, grid: { drawOnChartArea: false } },
    },
  },
});

// 2. avg ratings lines
new Chart(cRatings, {
  type: 'line',
  data: {
    labels: months,
    datasets: [
      { label: 'Complexity', data: mCx, borderColor: C.blue, backgroundColor: C.blue, tension: .3, pointRadius: 3 },
      { label: 'Effort', data: mEff, borderColor: C.green, backgroundColor: C.green, tension: .3, pointRadius: 3 },
      { label: 'Thought', data: mTh, borderColor: C.purple, backgroundColor: C.purple, tension: .3, pointRadius: 3 },
    ],
  },
  options: { maintainAspectRatio: false, scales: { y: { min: 0, max: 6, title: { display: true, text: 'avg rating (1–10)' } } } },
});

// 3. rating distributions
const distOf = f => { const d = Array(10).fill(0); DATA.forEach(c => d[Math.min(9, Math.max(0, f(c) - 1))]++); return d; };
new Chart(cDist, {
  type: 'bar',
  data: {
    labels: Array.from({ length: 10 }, (_, i) => i + 1),
    datasets: [
      { label: 'Complexity', data: distOf(c => c.cx), backgroundColor: 'rgba(88,166,255,.6)' },
      { label: 'Effort', data: distOf(c => c.eff), backgroundColor: 'rgba(63,185,80,.6)' },
      { label: 'Thought', data: distOf(c => c.th), backgroundColor: 'rgba(188,140,255,.6)' },
    ],
  },
  options: { maintainAspectRatio: false, scales: { x: { title: { display: true, text: 'rating' } }, y: { title: { display: true, text: 'commits' } } } },
});

// 4. hours histogram
const buckets = [[0, .5, '≤0.5h'], [.5, 1, '0.5–1h'], [1, 2, '1–2h'], [2, 4, '2–4h'], [4, 8, '4–8h'], [8, 16, '8–16h'], [16, 1e9, '16h+']];
const hCounts = buckets.map(([lo, hi]) => DATA.filter(c => c.hrs > lo && c.hrs <= hi).length);
hCounts[0] += DATA.filter(c => c.hrs === 0).length;
const hSums = buckets.map(([lo, hi]) => Math.round(sum(DATA.filter(c => c.hrs > lo && c.hrs <= hi), c => c.hrs)));
new Chart(cHours, {
  type: 'bar',
  data: {
    labels: buckets.map(b => b[2]),
    datasets: [
      { label: 'Commits', data: hCounts, backgroundColor: 'rgba(57,197,207,.6)', yAxisID: 'y' },
      { label: 'Total hours in bucket', data: hSums, backgroundColor: 'rgba(210,153,34,.55)', yAxisID: 'y2' },
    ],
  },
  options: {
    maintainAspectRatio: false,
    scales: {
      y: { title: { display: true, text: 'commits' } },
      y2: { position: 'right', title: { display: true, text: 'hours' }, grid: { drawOnChartArea: false } },
    },
  },
});

// 5. types doughnut
const typeOf = s => {
  const t = s.toLowerCase();
  if (/^(feat|feature)\b|^(add|new|implement|introduce)\b/.test(t)) return 'feature';
  if (/^(bug)?fix|^hotfix/.test(t)) return 'fix';
  if (/^refactor|^restructure|^rework/.test(t)) return 'refactor';
  if (/^(update|improve|enhance|polish|tweak|adjust)\b/.test(t)) return 'improve';
  if (/^(remove|delete|drop|clean)\b/.test(t)) return 'remove';
  if (/^chore|^bump|^upgrade|^deps\b/.test(t)) return 'chore';
  if (/^docs?\b|^readme/.test(t)) return 'docs';
  if (/^test/.test(t)) return 'test';
  if (/^(build|ci)\b/.test(t)) return 'build/ci';
  if (/^release/.test(t)) return 'release';
  if (/^revert/.test(t)) return 'revert';
  if (/^merge\b/.test(t)) return 'merge';
  return 'other';
};
const typeCounts = {};
DATA.forEach(c => { const t = typeOf(c.s); typeCounts[t] = (typeCounts[t] || 0) + 1; });
const typeEntries = Object.entries(typeCounts).sort((a, b) => b[1] - a[1]);
new Chart(cTypes, {
  type: 'doughnut',
  data: {
    labels: typeEntries.map(e => `${e[0]} (${e[1]})`),
    datasets: [{ data: typeEntries.map(e => e[1]), backgroundColor: [C.blue, C.green, C.orange, C.purple, C.cyan, C.red, '#e3b341', '#7ee787', '#ffa657', '#a5d6ff', '#d2a8ff', '#ff7b72', '#8b949e'], borderColor: css('--surface'), borderWidth: 2 }],
  },
  options: { maintainAspectRatio: false, plugins: { legend: { position: 'right' } } },
});

// 6. cumulative hours
let acc = 0;
const cum = mHours.map(h => +(acc += h).toFixed(0));
new Chart(cCum, {
  type: 'line',
  data: { labels: months, datasets: [{ label: 'Cumulative est. hours', data: cum, borderColor: C.green, backgroundColor: 'rgba(63,185,80,.15)', fill: true, tension: .3, pointRadius: 3 }] },
  options: { maintainAspectRatio: false, scales: { y: { beginAtZero: true } } },
});

// 7. top table
const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const topCommits = [...DATA].sort((a, b) => b.hrs - a.hrs).slice(0, 15);
document.querySelector('#tTop tbody').innerHTML = topCommits.map(c =>
  `<tr><td><code>${esc(c.h)}</code></td><td>${c.d}</td><td>${esc(c.s)}</td><td class="num">${c.cx}</td><td class="num">${c.eff}</td><td class="num">${c.th}</td><td class="num">${c.hrs}</td></tr>`
).join('');
