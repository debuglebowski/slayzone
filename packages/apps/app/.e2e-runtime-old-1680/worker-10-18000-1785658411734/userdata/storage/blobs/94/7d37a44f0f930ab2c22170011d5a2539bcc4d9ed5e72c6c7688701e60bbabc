%% Normain — Production network diagram
%% Source of truth: normain/terraform (modules/azure, modules/normain-kubernetes,
%% modules/customer-tenant, environments/app-production). Reflects IaC as of 2026-06-10.
%% Supersedes the outdated Vanta PDF (Container App + jump server) — that picture is wrong.
flowchart TB
  client(["Clients / Internet"])

  subgraph extdns["External DNS & TLS"]
    cf["Cloudflare DNS — zone normain.com<br/>per-tenant A record, proxied=false (DNS-only)"]
    le["Let's Encrypt (ACME)<br/>cert-manager, DNS-01 via Cloudflare"]
  end

  subgraph sub["Azure Subscription a9049f9f… (tenant: Normain)"]
    direction TB

    subgraph rgprod["RG rg-normain-prod-01 — region: Sweden Central"]
      direction TB

      lb["Azure Standard Load Balancer + public IP<br/>(provisioned by AKS LoadBalancer service)"]

      subgraph vnet["VNet vnet-normain-prod-01 — 10.0.0.0/16 — Network Watcher flow logs on all subnets (v2, 365d)"]
        direction TB

        subgraph snetaks["snet-aks 10.0.6.0/24 — service endpoints: KeyVault, Storage"]
          akscfg["AKS aks-normain-prod-01<br/>kubenet · pods 10.2.0.0/16 · svc 10.1.0.0/16<br/>Istio mesh + Gateway API · Workload Identity + OIDC · Azure RBAC · local accounts disabled"]
          gw["Ingress Gateway 'normain'<br/>per-tenant listeners HTTP:80 →301→ HTTPS:443<br/>TLS terminate (Let's Encrypt)"]
          api["api Deployment :3000<br/>2–N replicas · HPA · PDB · topology spread"]
          worker["worker Deployment :3003<br/>2–N replicas · HPA · PDB"]
          goten["gotenberg :3000<br/>in-cluster PDF render"]
        end

        subgraph snetdb["snet-db 10.0.3.0/24 — NSG: allow TCP 5432 from snet-aks, deny rest"]
          psql[("PostgreSQL Flexible Server psql-normain-prod-01 · v16<br/>VNet-integrated · public access OFF · Entra+password · pgaudit · pgvector<br/>zone 1 (no zone-HA) · 14d backup, geo-redundant OFF")]
        end

        subgraph snetpe["snet-pe 10.0.7.0/24 — NSG: allow TCP 10000 from snet-aks, deny rest"]
          redis[("Azure Managed Redis (per tenant)<br/>private endpoint only · public access OFF · TLS :10000")]
        end

        snetapi["snet-api 10.0.2.0/24<br/>delegated to Container Apps — no app currently deployed"]
        snetvm["snet-vm 10.0.5.0/24<br/>reserved — no workload"]
      end

      kv["Key Vault: kv- + kv-tf-normain-prod-01<br/>RBAC · purge protection · consumed via CSI secrets-store"]
      blob["Storage: uploaded_files + artifacts<br/>Blob · LRS · VNet service-endpoint, default deny"]
      nfs["Storage: data_sources<br/>Premium FileStorage / NFS · RWX volume"]
      law["Log Analytics workspace + Action Group (CAP-7 alerts)"]
    end

    subgraph airegions["Azure AI Foundry / OpenAI — Cognitive Services accounts"]
      ai["OpenAI (multi-region, data residency):<br/>Sweden Central · West Europe · France Central · Germany West Central · Norway East"]
      di["Document Intelligence (FormRecognizer)<br/>Sweden Central"]
    end

    subgraph rgglobal["RG rg-normain-global (shared)"]
      acr["Azure Container Registry (ACR)<br/>container image source"]
      flarch["Flow-log archive storage<br/>stsublogarch"]
    end
  end

  subgraph saas["External SaaS"]
    bs["BetterStack — logs/observability (eu-nbg-2)"]
  end

  %% North–south ingress
  client -->|"DNS query"| cf
  client -->|"HTTPS 443 → LB public IP"| lb
  lb --> gw
  gw -->|"HTTPRoute /"| api
  gw -->|"HTTPRoute /worker"| worker

  %% App → data tier (private)
  api -->|"5432 (private)"| psql
  worker -->|"5432 (private)"| psql
  api -->|"10000 TLS (PE)"| redis
  worker -->|"10000 TLS (PE)"| redis
  api -->|"secrets via CSI"| kv
  worker -->|"secrets via CSI"| kv
  api -->|"blob (svc endpoint)"| blob
  worker -->|"blob (svc endpoint)"| blob
  api -->|"NFS mount"| nfs
  worker -->|"NFS mount"| nfs
  api -->|"HTTP in-cluster"| goten
  api -->|"HTTPS"| ai
  worker -->|"HTTPS"| ai
  api -->|"HTTPS"| di

  %% Platform / ops plane
  akscfg -->|"image pull"| acr
  cf -.->|"DNS-01 challenge"| le
  le -.->|"issued cert"| gw
  akscfg -.->|"log shipping"| bs
