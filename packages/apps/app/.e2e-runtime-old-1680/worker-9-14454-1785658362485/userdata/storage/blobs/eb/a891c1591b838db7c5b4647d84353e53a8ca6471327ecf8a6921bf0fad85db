flowchart LR
    subgraph External["External"]
        direction TB
        Situations(("`⚡ **Situations**`"))
        Variables[("`**Variables**
        market size
        price sensitivity
        base costs`")]
        Situations -.->|modify| Variables
    end

    subgraph Round["Per-round loop"]
        direction TB
        Start([Round start])
        Agent[Agent decisions]
        State[("`**Company state**
        cash
        capacity
        brand
        models
        research`")]
        Compute["`**Market & cash update**
        share
        revenue
        burn`"]
        Check{Continue?}
        EndN([End])

        Start --> Agent --> State --> Compute --> Check
        Check -->|no| Start
        Check -->|yes| EndN
    end

    Variables -.->|read| Compute
    Situations -.->|modify| State
