<!doctype html>
<html lang="en" data-mode="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>biotracker — Warm Clinical</title>
<style>
  /* ============================================================
     RETAKE D · WARM CLINICAL  (recombination)
     = Clean & Clinical LAYOUT  (hairline cards, data-forward rows,
       deltas, caps labels, tight iOS geometry)
     + Refined Warm PALETTE     (warm paper, slate ink, coral action)
     + Dark Vitals NAV FORM     (circular glowing center action,
                                  glowing active icon + indicator)
     Chart color validated: coral #e5675c passes on light surface.
     ============================================================ */
  :root[data-mode="light"] {
    --bg:            #f4ece7;   /* warm paper */
    --bg-elev:       #faf5f1;
    --card:          #ffffff;   /* solid cards */
    --card-sunken:   #f1e9e3;
    --ink:           #24303a;   /* slate near-black */
    --ink-soft:      rgba(74,90,102,.55);
    --ink-soft2:     #4a5a66;
    --ink-mut:       #8a8079;   /* warm grey */
    --line:          #e7ddd5;   /* hairline */
    --line-strong:   #d8cabf;
    --brand:         #2f5061;   /* slate identity */
    --act:           #e5675c;   /* coral action */
    --act-ink:       #ffffff;
    --act-soft:      #fbe7e4;
    --good:          #4f9d7f;
    --up:            #4f9d7f;
    --down:          #d9534a;
    --chart:         #e5675c;
    --shadow:        0 1px 2px rgba(36,48,58,.06);
    --shadow-pop:    0 4px 14px rgba(36,48,58,.12);
    --shadow-fab:    0 6px 16px rgba(229,103,92,.45);
  }
  :root[data-mode="dark"] {
    --bg:            #191614;
    --bg-elev:       #211d1a;
    --card:          #262019;
    --card-sunken:   #1f1a15;
    --ink:           #f3ece6;
    --ink-soft:      rgba(203,191,181,.55);
    --ink-soft2:     #cbbfb5;
    --ink-mut:       #948a80;
    --line:          #352d26;
    --line-strong:   #453b32;
    --brand:         #6fa3bd;
    --act:           #f0776c;
    --act-ink:       #2a0f0c;
    --act-soft:      #3a201d;
    --good:          #5cae8e;
    --up:            #5cae8e;
    --down:          #f0776c;
    --chart:         #f0776c;
    --shadow:        0 1px 2px rgba(0,0,0,.4);
    --shadow-pop:    0 4px 14px rgba(0,0,0,.5);
    --shadow-fab:    0 6px 18px rgba(0,0,0,.5);
  }
</style>
<style>
  * { box-sizing: border-box; }
  body { margin:0; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,sans-serif; background:#232326; color:#ddd; }
  .toolbar { position:sticky; top:0; z-index:50; display:flex; align-items:center; gap:16px; padding:14px 24px; background:#151517; border-bottom:1px solid #333; }
  .toolbar h1 { font-size:15px; margin:0; font-weight:600; letter-spacing:.3px; }
  .toolbar .sub { font-size:12px; color:#8a8a8a; }
  .toolbar .spacer { flex:1; }
  .toolbar button { font:inherit; font-size:13px; background:#e5675c; color:#fff; border:none; padding:7px 16px; border-radius:8px; cursor:pointer; }
  .gallery { display:flex; flex-wrap:wrap; gap:34px; padding:36px; align-items:flex-start; justify-content:center; }
  .frame-wrap { display:flex; flex-direction:column; gap:11px; align-items:center; }
  .frame-label { font-size:11px; color:#8a8a8a; letter-spacing:1px; text-transform:uppercase; }
  .device { width:308px; height:646px; border-radius:44px; background:#0a0a0a; padding:11px; box-shadow:0 24px 60px rgba(0,0,0,.55); position:relative; }
  .screen { width:100%; height:100%; border-radius:33px; overflow:hidden; background:var(--bg); color:var(--ink); display:flex; flex-direction:column; position:relative; font-size:14px; }
  .notch { position:absolute; top:11px; left:50%; transform:translateX(-50%); width:118px; height:24px; background:#0a0a0a; border-radius:13px; z-index:30; }
  .statusbar { height:44px; flex:none; display:flex; align-items:flex-end; justify-content:space-between; padding:0 22px 5px; font-size:12px; font-weight:600; color:var(--ink); }
  .statusbar .r { display:flex; gap:5px; }
  .body { flex:1; overflow:hidden; }
  .scroll { height:100%; overflow:auto; padding:6px 16px 20px; }
  .scroll::-webkit-scrollbar { display:none; }

  /* --- Dark Vitals NAV FORM (remapped --coral → --act) --- */
  .tabbar { height:80px; flex:none; border-top:1px solid var(--line); background:var(--bg-elev); display:flex; align-items:flex-start; justify-content:space-between; padding:11px 34px 0; }
  .tab { position:relative; width:56px; display:flex; flex-direction:column; gap:5px; align-items:center; color:var(--ink-mut); font-size:11px; font-weight:600; letter-spacing:.2px; }
  .tab svg { width:23px; height:23px; stroke:currentColor; fill:none; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
  .tab .ind { position:absolute; top:-11px; width:20px; height:3px; border-radius:2px; background:transparent; }
  .tab.active { color:var(--act); }
  .tab.active svg { filter:drop-shadow(0 0 5px var(--act)); }
  .tab.active .ind { background:var(--act); box-shadow:0 0 6px var(--act); }
  .tabaction { width:54px; height:54px; border-radius:27px; background:var(--act); color:var(--act-ink); display:grid; place-items:center; margin-top:-16px; box-shadow:var(--shadow-fab); border:3px solid var(--bg-elev); }
  .tabaction svg { width:25px; height:25px; stroke:currentColor; fill:none; stroke-width:2.4; stroke-linecap:round; }
</style>
<style>
  /* Clean & Clinical LAYOUT (unchanged; consumes warm tokens) */
  .apphead { display:flex; align-items:center; gap:10px; padding:8px 16px 12px; }
  .apphead .brand { font-size:22px; font-weight:800; letter-spacing:-.5px; color:var(--ink); }
  .apphead .spacer { flex:1; }
  .apphead .iconbtn { width:36px; height:36px; border-radius:10px; background:var(--card); border:1px solid var(--line); display:grid; place-items:center; color:var(--ink-soft2); font-size:18px; }
  .stackhead { display:flex; align-items:center; gap:8px; padding:8px 14px 14px; }
  .stackhead .back { font-size:24px; color:var(--act); width:22px; line-height:1; }
  .stackhead .title { font-size:19px; font-weight:800; letter-spacing:-.3px; color:var(--ink); }
  .stackhead .spacer { flex:1; }
  .stackhead .save { color:var(--act); font-weight:700; font-size:15px; }
  .stackhead .plus { width:34px; height:34px; border-radius:10px; background:var(--act); color:var(--act-ink); display:grid; place-items:center; font-size:19px; }

  .sectitle { font-size:11px; font-weight:700; letter-spacing:.6px; color:var(--ink-mut); text-transform:uppercase; margin:18px 2px 8px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow); overflow:hidden; }
  .card + .card { margin-top:10px; }
  .prow { display:flex; align-items:center; gap:12px; padding:14px 14px; }
  .prow + .prow { border-top:1px solid var(--line); }
  .prow .ic { width:32px; height:32px; border-radius:9px; background:var(--card-sunken); display:grid; place-items:center; font-size:15px; }
  .prow .lead { flex:1; min-width:0; }
  .prow .lead .t { font-weight:600; color:var(--ink); }
  .prow .lead .s { font-size:12px; color:var(--ink-mut); margin-top:1px; }
  .prow .metric { text-align:right; }
  .prow .metric .v { font-size:17px; font-weight:700; color:var(--ink); font-variant-numeric:tabular-nums; letter-spacing:-.3px; }
  .prow .metric .v small { font-size:11px; color:var(--ink-mut); font-weight:600; }
  .prow .metric .d { font-size:11px; font-weight:700; }
  .prow .metric .d.up { color:var(--up); } .prow .metric .d.down { color:var(--down); }
  .prow .chev { color:var(--line-strong); font-size:18px; }
  .prow .val { color:var(--ink-mut); font-size:13px; font-variant-numeric:tabular-nums; }
  .caps { font-size:10px; font-weight:700; letter-spacing:.8px; text-transform:uppercase; color:var(--ink-mut); }

  .banner { display:flex; gap:10px; align-items:center; background:var(--act-soft); border:1px solid var(--act); border-radius:12px; padding:11px 13px; margin-top:6px; }
  .banner .i { color:var(--act); font-size:15px; }
  .banner .tx { font-size:12.5px; line-height:1.4; color:var(--ink-soft2); }
  .banner .tx b { color:var(--ink); }

  .statcard { background:var(--card); border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow); padding:14px; }
  .statcard .top { display:flex; justify-content:space-between; align-items:flex-start; }
  .statcard .num { font-size:30px; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums; letter-spacing:-1px; line-height:1; }
  .statcard .num small { font-size:15px; color:var(--ink-mut); font-weight:600; }
  .statcard .d { font-size:12px; font-weight:700; color:var(--up); }
  .miniline { margin-top:10px; }

  .label { font-size:11px; font-weight:700; color:var(--ink-mut); letter-spacing:.6px; text-transform:uppercase; margin:16px 2px 6px; }
  .field { background:var(--card); border:1px solid var(--line-strong); border-radius:11px; padding:13px 13px; color:var(--ink); font-size:16px; display:flex; align-items:center; justify-content:space-between; }
  .field .ph { color:var(--ink-mut); }
  .field.focus { border-color:var(--act); box-shadow:0 0 0 3px var(--act-soft); }
  .btn { height:44px; border-radius:11px; display:flex; align-items:center; justify-content:center; gap:8px; font-weight:700; font-size:15px; margin-top:12px; }
  .btn.primary { background:var(--act); color:var(--act-ink); box-shadow:var(--shadow-fab); }
  .btn.ghost { background:var(--card); color:var(--ink-soft2); border:1px solid var(--line-strong); }
  .btn.danger { background:transparent; color:var(--down); border:1px solid var(--down); }

  .seg { display:flex; background:var(--card-sunken); border-radius:11px; padding:3px; gap:3px; }
  .seg > div { flex:1; text-align:center; padding:8px 6px; font-size:13px; font-weight:600; color:var(--ink-soft2); border-radius:8px; display:flex; align-items:center; justify-content:center; gap:5px; }
  .seg > div.on { background:var(--card); color:var(--act); box-shadow:var(--shadow-pop); }

  .chartcard { background:var(--card); border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow); padding:14px; margin-top:10px; }
  .chartcard .ct { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:6px; }
  .chartcard .ct .nm { font-weight:700; color:var(--ink); }
  .chartcard .ct .rg { font-size:11px; color:var(--ink-mut); }
  .kpis { display:flex; gap:10px; margin-top:10px; }
  .kpi { flex:1; background:var(--card); border:1px solid var(--line); border-radius:12px; padding:11px 12px; }
  .kpi .k { font-size:10px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:var(--ink-mut); }
  .kpi .v { font-size:19px; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums; margin-top:3px; letter-spacing:-.5px; }
  .kpi .v small { font-size:12px; color:var(--ink-mut); font-weight:600; }

  .stars { font-size:22px; letter-spacing:5px; color:var(--act); }
  .stars .off { color:var(--line-strong); }
  .dots { display:flex; gap:7px; justify-content:center; margin:20px 0 6px; }
  .dots span { width:7px; height:7px; border-radius:4px; background:var(--line-strong); }
  .dots span.on { background:var(--act); width:20px; }
  .center { text-align:center; margin-top:24px; }
  .center .cat { font-size:11px; letter-spacing:.8px; color:var(--ink-mut); text-transform:uppercase; font-weight:700; }
  .center .dp { font-size:26px; font-weight:800; letter-spacing:-.5px; color:var(--ink); margin-top:5px; }
  .biginput { margin:24px auto 0; width:80%; background:var(--card); border:1px solid var(--line-strong); border-radius:14px; padding:20px; text-align:center; font-size:30px; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums; }
  .biginput small { font-size:15px; color:var(--ink-mut); font-weight:600; }
  .navrow { display:flex; gap:10px; padding:14px 16px 22px; }
  .navrow .btn { flex:1; margin:0; }
  .cal { display:flex; align-items:center; justify-content:center; gap:16px; color:var(--ink-soft2); font-weight:600; font-size:14px; padding-bottom:8px; }
  .cal .a { color:var(--act); }
</style>
</head>
<body data-palette="#e5675c">
  <div class="toolbar">
    <h1>Retake D · Warm Clinical</h1>
    <span class="sub">clean layout · warm palette · dark-vitals glowing nav</span>
    <span class="spacer"></span>
    <button onclick="tm()" id="mb">◐ Dark</button>
  </div>
  <div class="gallery" id="g"></div>

<script>
const sb = `<div class="statusbar"><span>9:41</span><span class="r">◍ ⌵ ▮</span></div>`;
const IC = {
  input: `<svg viewBox="0 0 24 24"><path d="M4 20h16"/><path d="M14.5 4.5l3 3L8 17l-4 1 1-4z"/></svg>`,
  charts: `<svg viewBox="0 0 24 24"><path d="M4 19V5"/><path d="M4 19h16"/><path d="M8 15l3.5-4 3 2.5L20 7"/></svg>`,
  plus: `<svg viewBox="0 0 24 24"><path d="M12 5v14"/><path d="M5 12h14"/></svg>`,
};
const tab = (a)=>`<div class="tabbar">
  <div class="tab ${a=='i'?'active':''}"><span class="ind"></span>${IC.input}Input</div>
  <div class="tabaction">${IC.plus}</div>
  <div class="tab ${a=='c'?'active':''}"><span class="ind"></span>${IC.charts}Charts</div></div>`;
const mini = (pts,w=270,h=44)=>`<svg class="miniline" viewBox="0 0 ${w} ${h}" width="100%" height="${h}" preserveAspectRatio="none">
  <defs><linearGradient id="mg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--chart)" stop-opacity=".18"/><stop offset="1" stop-color="var(--chart)" stop-opacity="0"/></linearGradient></defs>
  <path d="M${pts} L${w},${h} L0,${h} Z" fill="url(#mg)"/>
  <polyline fill="none" stroke="var(--chart)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="${pts}"/></svg>`;

const S = {
"01 · input home": `${sb}
  <div class="apphead"><span class="brand">Biotracker</span><span class="spacer"></span><div class="iconbtn">☰</div></div>
  <div class="body"><div class="scroll">
    <div class="banner"><span class="i">🔔</span><span class="tx"><b>Enable notifications</b> to receive reminders.</span></div>
    <div class="sectitle">Sleep</div>
    <div class="card">
      <div class="prow"><span class="ic">🌙</span><span class="lead"><div class="t">Hours slept</div><div class="s">Today</div></span>
        <span class="metric"><div class="v">7.5<small>h</small></div><div class="d up">↑ 0.4</div></span><span class="chev">›</span></div>
      <div class="prow"><span class="ic">✦</span><span class="lead"><div class="t">Sleep quality</div><div class="s">Today</div></span>
        <span class="metric"><div class="v">4<small>/5</small></div><div class="d up">↑ 1</div></span><span class="chev">›</span></div>
    </div>
    <div class="sectitle">Mood</div>
    <div class="card">
      <div class="prow"><span class="ic">☺</span><span class="lead"><div class="t">Overall mood</div><div class="s">Not logged</div></span><span class="metric"><div class="v" style="color:var(--ink-mut)">—</div></span><span class="chev">›</span></div>
      <div class="prow"><span class="ic">⚡</span><span class="lead"><div class="t">Energy</div><div class="s">2h ago</div></span>
        <span class="metric"><div class="v">6<small>/10</small></div><div class="d down">↓ 1</div></span><span class="chev">›</span></div>
    </div>
  </div></div>
  ${tab('i')}`,

"02 · entry list": `${sb}
  <div class="stackhead"><span class="back">‹</span><span class="title">Hours slept</span><span class="spacer"></span><div class="plus">＋</div></div>
  <div class="cal"><span class="a">◀</span> Sat, Jul 12 <span class="a">▶</span></div>
  <div class="body"><div class="scroll">
    <div class="statcard"><div class="top"><div><div class="caps">Today</div><div class="num" style="margin-top:4px">7.5<small>h</small></div></div><div class="d">↑ 0.4 vs 7-day avg</div></div>${mini('0,36 45,20 90,8 135,24 180,14 225,28 270,12')}</div>
    <div class="sectitle">Entries · 2</div>
    <div class="card">
      <div class="prow"><span class="lead"><div class="t">7.5 h</div><div class="s">Morning</div></span><span class="val">09:14</span><span class="chev">›</span></div>
      <div class="prow"><span class="lead"><div class="t">8.0 h</div><div class="s">Nap</div></span><span class="val">14:40</span><span class="chev">›</span></div>
    </div>
  </div></div>
  ${tab('i')}`,

"03 · entry all": `${sb}
  <div class="stackhead"><span class="back">‹</span><span class="title">Log entries</span></div>
  <div class="body">
    <div class="center"><div class="cat">Sleep · 3 of 5</div><div class="dp">Hours slept</div></div>
    <div class="biginput">7.5 <small>h</small></div>
    <div class="dots"><span class="on"></span><span></span><span></span><span></span><span></span></div>
    <p style="text-align:center;color:var(--ink-mut);font-size:13px;margin-top:14px">Tap Next for each datapoint</p>
  </div>
  <div class="navrow"><div class="btn ghost">Skip</div><div class="btn primary">Next</div></div>`,

"04 · charts": `${sb}
  <div class="apphead"><span class="brand">Charts</span><span class="spacer"></span><div class="iconbtn">＋</div></div>
  <div class="body"><div class="scroll">
    <div class="seg"><div class="on">Sleep</div><div>30 days</div><div>Daily</div></div>
    <div class="chartcard">
      <div class="ct"><span class="nm">Hours slept</span><span class="rg">Jun 12 – Jul 12</span></div>
      <svg viewBox="0 0 250 130" width="100%" height="150" preserveAspectRatio="none">
        <defs><linearGradient id="ga" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--chart)" stop-opacity=".16"/><stop offset="1" stop-color="var(--chart)" stop-opacity="0"/></linearGradient></defs>
        <g stroke="var(--line)" stroke-width="1"><line x1="24" y1="14" x2="250" y2="14"/><line x1="24" y1="52" x2="250" y2="52"/><line x1="24" y1="90" x2="250" y2="90"/></g>
        <g fill="var(--ink-mut)" font-size="9"><text x="4" y="18">9</text><text x="4" y="56">7</text><text x="4" y="94">5</text></g>
        <path d="M30,90 64,58 98,34 132,56 166,40 200,64 234,48 L234,118 L30,118 Z" fill="url(#ga)"/>
        <polyline fill="none" stroke="var(--chart)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" points="30,90 64,58 98,34 132,56 166,40 200,64 234,48"/>
        <circle cx="234" cy="48" r="4" fill="var(--chart)" stroke="var(--card)" stroke-width="2"/>
      </svg>
    </div>
    <div class="kpis"><div class="kpi"><div class="k">Average</div><div class="v">7.1<small>h</small></div></div>
      <div class="kpi"><div class="k">Best</div><div class="v">8.4<small>h</small></div></div>
      <div class="kpi"><div class="k">Streak</div><div class="v">12<small>d</small></div></div></div>
  </div></div>
  ${tab('c')}`,

"05 · settings home": `${sb}
  <div class="stackhead"><span class="back">‹</span><span class="title">Settings</span></div>
  <div class="body"><div class="scroll">
    <div class="sectitle">General</div>
    <div class="card"><div class="prow"><span class="ic">◐</span><span class="lead"><div class="t">Appearance</div></span><span class="val">System</span><span class="chev">›</span></div></div>
    <div class="sectitle">Input</div>
    <div class="card">
      <div class="prow"><span class="ic">◇</span><span class="lead"><div class="t">Categories</div></span><span class="val">4</span><span class="chev">›</span></div>
      <div class="prow"><span class="ic">⦿</span><span class="lead"><div class="t">Datapoints</div></span><span class="val">11</span><span class="chev">›</span></div></div>
    <div class="sectitle">Charts</div>
    <div class="card"><div class="prow"><span class="ic">▤</span><span class="lead"><div class="t">Charts</div></span><span class="val">3</span><span class="chev">›</span></div></div>
    <div class="sectitle">Notifications</div>
    <div class="card"><div class="prow"><span class="ic">🔔</span><span class="lead"><div class="t">Notifications</div></span><span class="val">3 active</span><span class="chev">›</span></div></div>
    <div class="sectitle">Account</div>
    <div class="card"><div class="prow"><span class="ic" style="color:var(--down)">🗑</span><span class="lead"><div class="t" style="color:var(--down)">Delete account</div></span></div></div>
  </div></div>`,

"06 · settings list": `${sb}
  <div class="stackhead"><span class="back">‹</span><span class="title">Datapoints</span><span class="spacer"></span><div class="plus">＋</div></div>
  <div class="body"><div class="scroll">
    <div class="sectitle">Sleep</div>
    <div class="card">
      <div class="prow"><span class="ic">🌙</span><span class="lead"><div class="t">Hours slept</div><div class="s">Number · h</div></span><span class="chev">›</span></div>
      <div class="prow"><span class="ic">✦</span><span class="lead"><div class="t">Sleep quality</div><div class="s">Rating · 1–5</div></span><span class="chev">›</span></div></div>
    <div class="sectitle">Mood</div>
    <div class="card">
      <div class="prow"><span class="ic">☺</span><span class="lead"><div class="t">Overall mood</div><div class="s">Rating · 1–5</div></span><span class="chev">›</span></div>
