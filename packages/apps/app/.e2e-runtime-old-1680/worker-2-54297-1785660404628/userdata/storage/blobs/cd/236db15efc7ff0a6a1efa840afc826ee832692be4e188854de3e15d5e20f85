### Electron main — `EmbeddedServerHandle`

```ts
export type EmbeddedServerOpts = {
  execPath: string          // process.execPath (Electron binary)
  scriptPath: string        // absolute dist/bin.js
  env: NodeJS.ProcessEnv    // includes ELECTRON_RUN_AS_NODE=1, SLAYZONE_*
  host: string
  logger: (line: string) => void
  onReady: (info: { pid: number; port: number }) => void
  onPermanentFailure: (info: { attempts: number; lastError: unknown }) => void
}

export type EmbeddedServerHandle = {
  getPort: () => number | null
  getHealth: () => 'starting' | 'ready' | 'restarting' | 'failed'
  waitForReady: () => Promise<void>      // rejects on permanent failure
  stop: () => Promise<void>
  restart: () => Promise<void>           // test-reset path
}

export function startEmbeddedServer(opts: EmbeddedServerOpts): EmbeddedServerHandle
```

Lifecycle:
- Pre-probe free port via `net.createServer().listen(0)` → close → pass via env.
- `spawn(process.execPath, [scriptPath], {env:{...ELECTRON_RUN_AS_NODE:'1'}, stdio:['ignore','pipe','pipe']})`.
- Health poll `GET /health` every 250ms until 200 OK or 10s timeout.
- Exit handler: exp backoff `[1,2,4,8,16]s`, max 5 attempts. 60s healthy-streak resets counter.
- `stop()`: SIGTERM, 3s grace, SIGKILL.

