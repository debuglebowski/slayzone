const wrap = document.getElementById('wrap');
const tip = document.getElementById('tip');

function bucketKey(dateStr, g) {
  if (g === 'day') return dateStr;
  if (g === 'month') return dateStr.slice(0, 7);
  // week: ISO Monday-based key
  const d = new Date(dateStr + 'T00:00:00Z');
  const dow = (d.getUTCDay() + 6) % 7;
  d.setUTCDate(d.getUTCDate() - dow);
  return d.toISOString().slice(0, 10);
}

function aggregate(g) {
  const m = new Map();
  for (const r of raw) {
    const k = bucketKey(r.d, g);
    const cur = m.get(k) || { c: 0, p: 0 };
    cur.c += r.c; cur.p += r.p;
    m.set(k, cur);
  }
  const keys = [...m.keys()].sort();
  return keys.map(k => ({ k, c: m.get(k).c, p: m.get(k).p }));
}

function render(g) {
  const data = aggregate(g);
  const W = wrap.clientWidth, H = wrap.clientHeight;
  const padL = 40, padR = 12, padT = 10, padB = 40;
  const plotW = W - padL - padR, plotH = H - padT - padB;
  const maxV = Math.max(1, ...data.map(d => Math.max(d.c, d.p)));
  const niceMax = Math.ceil(maxV / 5) * 5 || 5;
  const bw = plotW / data.length;
  const barW = Math.max(1, Math.min(bw * 0.4, 20));

  const yTicks = 5;
  const yLines = [];
  const yLabels = [];
  for (let i = 0; i <= yTicks; i++) {
    const v = niceMax * i / yTicks;
    const y = padT + plotH - (v / niceMax) * plotH;
    yLines.push(`<line class="grid" x1="${padL}" x2="${padL+plotW}" y1="${y}" y2="${y}"/>`);
    yLabels.push(`<text class="tick" x="${padL-6}" y="${y+3}" text-anchor="end">${Math.round(v)}</text>`);
  }

  // x labels: show ~10 evenly spaced
  const step = Math.max(1, Math.ceil(data.length / 10));
  const xLabels = [];
  data.forEach((d, i) => {
    if (i % step === 0) {
      const x = padL + bw * i + bw / 2;
      xLabels.push(`<text class="tick" x="${x}" y="${padT+plotH+14}" text-anchor="middle">${d.k}</text>`);
    }
  });

  const bars = [];
  data.forEach((d, i) => {
    const xCenter = padL + bw * i + bw / 2;
    const xC = xCenter - barW - 1;
    const xP = xCenter + 1;
    const hC = (d.c / niceMax) * plotH;
    const hP = (d.p / niceMax) * plotH;
    bars.push(`<rect class="bar-c" data-k="${d.k}" data-c="${d.c}" data-p="${d.p}" x="${xC}" y="${padT+plotH-hC}" width="${barW}" height="${hC}"/>`);
    bars.push(`<rect class="bar-p" data-k="${d.k}" data-c="${d.c}" data-p="${d.p}" x="${xP}" y="${padT+plotH-hP}" width="${barW}" height="${hP}"/>`);
  });

  wrap.innerHTML = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">
    ${yLines.join('')}
    ${yLabels.join('')}
    ${xLabels.join('')}
    <line class="axis" x1="${padL}" x2="${padL+plotW}" y1="${padT+plotH}" y2="${padT+plotH}"/>
    <line class="axis" x1="${padL}" x2="${padL}" y1="${padT}" y2="${padT+plotH}"/>
    ${bars.join('')}
  </svg>`;

  wrap.querySelectorAll('rect').forEach(r => {
    r.addEventListener('mousemove', e => {
      tip.style.display = 'block';
      tip.style.left = (e.clientX + 10) + 'px';
      tip.style.top = (e.clientY + 10) + 'px';
      tip.innerHTML = `<b>${r.dataset.k}</b><br>Commits: ${r.dataset.c}<br>PRs: ${r.dataset.p}`;
    });
    r.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
  });
}

let current = 'week';
document.querySelectorAll('.controls button').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('.controls button').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    current = b.dataset.g;
    render(current);
  });
});

render(current);
window.addEventListener('resize', () => render(current));
