<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>normain — Estimated Hours per Month</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
  :root { --bg: #0d1117; --surface: #161b22; --border: #30363d; --text: #e6edf3; --muted: #8b949e; --orange: #d29922; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; padding: 32px 24px 64px; }
  .wrap { max-width: 1000px; margin: 0 auto; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  .sub { color: var(--muted); margin-bottom: 24px; font-size: 14px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 18px; }
  .chart-box { position: relative; height: 460px; }
  .note { font-size: 12px; color: var(--muted); margin-top: 20px; line-height: 1.5; }
</style>
</head>
<body>
<div class="wrap">
  <h1>normain — Estimated Hours &amp; Complexity per Month</h1>
  <div class="sub">2025-06-10 → 2026-06-10 · 1,729 commits · 5,596 estimated hours total (adjusted) · rated by 13 parallel Sonnet agents</div>
  <div class="card">
    <div class="chart-box"><canvas id="cHours"></canvas></div>
  </div>
</div>
<script>
const MONTHS = ["2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06"];
const HOURS = [212.9,103.2,140.0,327.0,305.5,352.0,182.0,599.6,716.4,1029.8,684.8,702.0,240.8];
const CX_AVG = [2.32,2.17,2.41,3.67,3.62,4.12,3.48,4.04,3.44,3.53,3.5,3.95,3.75];
const CX_STD = [1.6,1.47,1.49,2.01,2.09,1.84,2.14,2.3,1.78,2.17,1.84,1.91,2.26];
const CX_HI = CX_AVG.map((v,i) => +(v + CX_STD[i]).toFixed(2));
const CX_LO = CX_AVG.map((v,i) => +Math.max(0, v - CX_STD[i]).toFixed(2));

Chart.defaults.animation = false;
Chart.defaults.color = '#8b949e';
Chart.defaults.borderColor = 'rgba(48,54,61,.6)';
Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;

const errorBars = {
  id: 'errorBars',
  afterDatasetsDraw(chart) {
    const meta = chart.getDatasetMeta(1);
    if (!meta || meta.hidden) return;
    const scale = chart.scales.y2;
    const ctx = chart.ctx;
    ctx.save();
    ctx.strokeStyle = 'rgba(88,166,255,.7)';
    ctx.lineWidth = 1.5;
    meta.data.forEach((pt, i) => {
      const yHi = scale.getPixelForValue(CX_HI[i]);
      const yLo = scale.getPixelForValue(CX_LO[i]);
      ctx.beginPath();
      ctx.moveTo(pt.x, yHi); ctx.lineTo(pt.x, yLo);          // whisker
      ctx.moveTo(pt.x - 5, yHi); ctx.lineTo(pt.x + 5, yHi);  // top cap
      ctx.moveTo(pt.x - 5, yLo); ctx.lineTo(pt.x + 5, yLo);  // bottom cap
      ctx.stroke();
    });
    ctx.restore();
  },
};

new Chart(cHours, {
  type: 'line',
  plugins: [errorBars],
  data: {
    labels: MONTHS,
    datasets: [{
      label: 'Estimated hours',
      data: HOURS,
      borderColor: '#d29922',
      backgroundColor: '#d29922',
      fill: false,
      tension: .3,
      pointRadius: 4,
      pointBackgroundColor: '#d29922',
      borderWidth: 2.5,
      yAxisID: 'y',
    }, {
      label: 'Avg complexity',
      data: CX_AVG,
      borderColor: '#58a6ff',
      backgroundColor: '#58a6ff',
      tension: .3,
      pointRadius: 3,
      borderWidth: 2,
      fill: false,
      yAxisID: 'y2',
    }],
  },
  options: {
    maintainAspectRatio: false,
    plugins: {
      legend: { labels: { boxWidth: 12, boxHeight: 12 } },
      tooltip: {
        callbacks: {
          label: ctx => {
            if (ctx.dataset.yAxisID === 'y') return `${ctx.parsed.y} est. hours`;
            if (ctx.dataset.label === 'Avg complexity') return `avg complexity ${ctx.parsed.y} (σ ${CX_STD[ctx.dataIndex]})`;
            return null;
          },
        },
      },
    },
    scales: {
      y: { beginAtZero: true, title: { display: true, text: 'est. human-hours' } },
      y2: { position: 'right', min: 0, max: 10, title: { display: true, text: 'complexity (1–10)' }, grid: { drawOnChartArea: false } },
    },
  },
});
</script>
</body>
</html>
