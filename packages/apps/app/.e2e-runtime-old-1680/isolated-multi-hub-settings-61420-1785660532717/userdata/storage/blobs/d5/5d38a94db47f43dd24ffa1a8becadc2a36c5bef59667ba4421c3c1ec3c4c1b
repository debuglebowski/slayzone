const tab = (a)=>`<div class="tabbar">
  <div class="tab ${a=='i'?'active':''}"><span class="ic">⌨</span>Input</div>
  <div class="tab ${a=='c'?'active':''}"><span class="ic">📈</span>Charts</div></div>`;

const S = {
"01 · input home": `${sb}
