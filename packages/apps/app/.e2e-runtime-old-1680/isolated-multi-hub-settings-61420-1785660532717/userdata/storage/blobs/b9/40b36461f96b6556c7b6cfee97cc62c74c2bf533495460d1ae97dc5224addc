flowchart TD
    START([slayzone-hub boot]) --> G{"canPrompt?<br/>stdin.isTTY AND not SUPERVISED<br/>AND not NONINTERACTIVE"}
    G -- no --> SKIP["skip setup →<br/>applyStandaloneHubConfig<br/>(auto-gen secret, default ports)"]

    G -- yes --> H1{"publicUrl set?<br/>(env / config.json)"}
    H1 -- yes --> SKIP

    H1 -- no --> Q1["ask: Public hub URL<br/>(hint = https://hub.example.com)"]
    Q1 --> J1{"answer empty?"}
    J1 -- yes --> DROP["drop → loopback-only tokens"]
    J1 -- no --> C1["collect publicUrl"]

    DROP --> ANY
    C1 --> ANY{"any collected?"}
    ANY -- no --> SKIP
    ANY -- yes --> SEED["seed process.env<br/>(SLAYZONE_HUB_PUBLIC_URL)"]
    SEED --> SUM["print summary"]
    SUM --> CONF{"Save to config.json?<br/>[Y/n] (Enter=yes)"}
    CONF -- yes --> WRITE["updateSlayzoneConfig()<br/>atomic 0600 merge"]
    CONF -- no --> RUNONLY["run-only (not persisted)"]

    WRITE --> BOOT([applyStandaloneHubConfig → startServer])
    RUNONLY --> BOOT
    SKIP --> BOOT
