flowchart TB
  item(["Concept Item<br/>(instance)"])

  item --> D["**DOMAIN LAYER** — exists<br/>fields + relations<br/>generic, user-defined per concept"]
  item --> A["**ANNOTATION LAYER** — proposed<br/>notes · tasks · (comments · files)<br/>cross-cutting, attaches to ANY item"]
  item --> H["**HISTORY LAYER** — exists<br/>activity / event log<br/>per-instance"]

  A -. "every note/task add<br/>emits an event" .-> H

  classDef exists fill:#1f3a2e,stroke:#3ddc84,color:#e6ffe6;
  classDef prop fill:#3a2e1f,stroke:#f5a623,color:#fff3e0;
  class D,H exists;
  class A prop;

  subgraph FORK["The decision: how to build the annotation layer"]
    direction LR
    O1["**A. Fixed primitives** ✅ rec<br/>own tables, polymorphic<br/>subject = instance ref<br/>NOT concepts, NOT fields<br/>simple · ubiquitous · fast<br/>not user-extensible"]
    O2["**B. Seeded concepts**<br/>notes/tasks = default concepts<br/>linked by relations<br/>fully extensible<br/>but: ubiquity needs auto-relations,<br/>over-applies concept system"]
    O3["**C. Baked-in fields**<br/>note/task fields on every concept<br/>❌ pollutes schema,<br/>breaks 'generic / no special-casing'"]
  end
