<!doctype html>
<html><head><meta charset="utf-8"><style>
*{box-sizing:border-box;margin:0;padding:0}
body{font:13px/1.45 -apple-system,system-ui,sans-serif;color:#18181b;background:#f4f4f5;padding:28px}
.caption{max-width:960px;margin:0 auto 10px;color:#52525b;font-size:12px}
.caption b{color:#18181b}
.app{max-width:960px;margin:0 auto;background:#fff;border:1px solid #e4e4e7;border-radius:10px;box-shadow:0 1px 2px rgba(0,0,0,.04);position:relative}
.titlebar{padding:14px 18px;border-bottom:1px solid #ececef;display:flex;align-items:center;gap:10px}
h1{font-size:15px;font-weight:600}
.count{color:#9ca3af;font-size:12px}
.spacer{flex:1}
.btn{border:1px solid #e4e4e7;background:#fff;border-radius:6px;padding:5px 11px;font-size:12.5px;color:#3f3f46;display:inline-flex;align-items:center;gap:6px}
.btn.on{background:#eef2fe;border-color:#c7d4f8;color:#3b4f9e;font-weight:500}
.badge{background:#3b4f9e;color:#fff;border-radius:999px;font-size:10px;padding:0 5px;font-weight:600}
.pop{position:absolute;right:18px;top:52px;width:430px;background:#fff;border:1px solid #e4e4e7;border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,.13);padding:12px;z-index:5}
.prow{display:flex;align-items:center;gap:6px;margin-bottom:8px}
.lead{width:52px;font-size:12px;color:#71717a;text-align:right;padding-right:2px}
.sel{border:1px solid #e4e4e7;border-radius:6px;padding:4px 8px;font-size:12px;color:#18181b;background:#fafafa;display:inline-flex;align-items:center;gap:5px}
.sel i{font-style:normal;color:#a1a1aa;font-size:9px}
.x{color:#a1a1aa;margin-left:auto;padding:0 4px}
.pfoot{display:flex;align-items:center;border-top:1px solid #f1f1f4;padding-top:10px;margin-top:4px}
.add{font-size:12px;color:#3b4f9e;font-weight:500}
.match{margin-left:auto;display:inline-flex;border:1px solid #e4e4e7;border-radius:6px;overflow:hidden;font-size:11px}
.match span{padding:4px 9px;color:#71717a}
.match .on{background:#18181b;color:#fff}
table{width:100%;border-collapse:collapse;opacity:.45}
th{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#71717a;text-align:left;padding:8px 14px;border-bottom:1px solid #ececef;background:#fafafa;font-weight:500}
td{padding:9px 14px;border-bottom:1px solid #f1f1f4}
.pill{display:inline-block;padding:1px 8px;border-radius:999px;font-size:11.5px;font-weight:500}
.active{background:#dcfce7;color:#166534}
.nego{background:#fef9c3;color:#854d0e}
</style></head><body>
<div class="caption"><b>Layout 3 — Popover rule builder</b> (Notion-style). One "Filter" button with count badge; rules edited in a popover as "Where field · op · value" rows; table stays clean, filters hidden until opened. Same popover reusable verbatim inside WidgetEditor.</div>
<div class="app">
  <div class="titlebar"><h1>Deals</h1><span class="count">3 of 7 shown</span><div class="spacer"></div><span class="btn">⌕ Search</span><span class="btn on">Filter <span class="badge">3</span></span><span class="btn">Sort</span></div>
  <div class="pop">
    <div class="prow"><span class="lead">Where</span><span class="sel">Status <i>▾</i></span><span class="sel">is <i>▾</i></span><span class="sel"><span class="pill active">Active</span> <i>▾</i></span><span class="x">×</span></div>
    <div class="prow"><span class="lead">and</span><span class="sel">Amount <i>▾</i></span><span class="sel">&gt; <i>▾</i></span><span class="sel">50,000</span><span class="x">×</span></div>
    <div class="prow"><span class="lead">and</span><span class="sel">Labels <i>▾</i></span><span class="sel">has <i>▾</i></span><span class="sel">priority <i>▾</i></span><span class="x">×</span></div>
    <div class="pfoot"><span class="add">＋ Add filter</span><span class="match"><span class="on">All</span><span>Any</span></span></div>
  </div>
  <table>
    <tr><th>Name</th><th>Status</th><th>Amount</th><th>Close date</th><th>Owner</th></tr>
    <tr><td>Acme renewal</td><td><span class="pill active">Active</span></td><td>$82,000</td><td>Jul 1, 2026</td><td>Mia</td></tr>
    <tr><td>Globex expansion</td><td><span class="pill active">Active</span></td><td>$54,500</td><td>Jun 18, 2026</td><td>Theo</td></tr>
    <tr><td>Initech pilot</td><td><span class="pill nego">Negotiation</span></td><td>$23,000</td><td>Jun 30, 2026</td><td>Mia</td></tr>
    <tr><td>Umbrella upsell</td><td><span class="pill active">Active</span></td><td>$61,200</td><td>Aug 9, 2026</td><td>Ravi</td></tr>
  </table>
</div>
</body></html>
