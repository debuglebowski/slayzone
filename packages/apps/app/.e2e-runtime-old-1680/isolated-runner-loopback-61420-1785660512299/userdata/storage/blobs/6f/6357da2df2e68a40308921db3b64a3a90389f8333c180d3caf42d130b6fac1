<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>SlayZone Multi-Hub — Overview</title>
<style>
  :root{
    --bg:#0e1117; --ink:#e6edf3; --muted:#8b98a9;
    --client:#4c8dff; --local:#2ea043; --remote:#14b8a6; --runner:#d29922;
  }
  @media (prefers-color-scheme: light){ :root{ --bg:#f6f8fa; --ink:#1f2328; --muted:#59636e; } }
  html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;}
  .wrap{max-width:1000px;margin:0 auto;padding:28px 20px;}
  h1{font-size:19px;margin:0 0 2px;letter-spacing:-.01em;}
  p.sub{color:var(--muted);font-size:12.5px;margin:0 0 6px;}
  svg{width:100%;height:auto;display:block;}
  .lbl{fill:var(--ink);font-size:13px;font-weight:600;}
  .sub2{fill:var(--muted);font-size:10.5px;}
  .tier{fill:var(--muted);font-size:10px;letter-spacing:.12em;text-transform:uppercase;}
  .edgelbl{fill:var(--muted);font-size:9.5px;}
  .badge{fill:var(--muted);font-size:9px;}
  .legend{display:flex;gap:16px;flex-wrap:wrap;font-size:11.5px;color:var(--muted);margin-top:10px;}
  .legend span{display:inline-flex;align-items:center;gap:6px;}
  .sw{width:20px;height:0;border-top-width:2px;border-top-style:solid;display:inline-block;}
  .key{display:inline-block;width:11px;height:11px;border-radius:3px;}
</style>
</head>
<body>
<div class="wrap">
  <h1>SlayZone — Multi-Hub Federation</h1>
  <p class="sub">1 client → many hubs (federation). 1 hub → many runners (fleet). Local hub always on.</p>

  <svg viewBox="0 0 1000 560" role="img" aria-label="Architecture overview">
    <defs>
      <marker id="ar" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path d="M0,0 L6,3 L0,6 Z" fill="var(--muted)"/>
      </marker>
    </defs>

    <!-- tier labels -->
    <text x="8" y="40"  class="tier">Client</text>
    <text x="8" y="250" class="tier">Hubs · own the data</text>
    <text x="8" y="470" class="tier">Runners · exec only</text>

    <!-- ================= CLIENT ================= -->
    <rect x="360" y="24" width="280" height="60" rx="12" fill="none" stroke="var(--client)" stroke-width="2"/>
    <text x="500" y="50" text-anchor="middle" class="lbl">Desktop client</text>
    <text x="500" y="68" text-anchor="middle" class="sub2">1 app · connects to every hub at once</text>

    <!-- edges client -> hubs -->
    <!-- to local -->
    <path d="M430,84 C400,150 230,150 200,196" fill="none" stroke="var(--local)" stroke-width="2" marker-end="url(#ar)"/>
    <text x="250" y="150" class="edgelbl">ws:// loopback · no auth</text>
    <!-- to remote A -->
    <path d="M500,84 L500,196" fill="none" stroke="var(--remote)" stroke-width="2" marker-end="url(#ar)"/>
    <text x="512" y="150" class="edgelbl">wss:// · token + cert-pin</text>
    <!-- to remote B -->
    <path d="M570,84 C600,150 770,150 800,196" fill="none" stroke="var(--remote)" stroke-width="2" marker-end="url(#ar)"/>
    <text x="690" y="150" class="edgelbl">wss:// · token + cert-pin</text>

    <!-- ================= HUBS ================= -->
    <!-- LOCAL -->
    <rect x="90" y="198" width="220" height="86" rx="12" fill="none" stroke="var(--local)" stroke-width="2"/>
    <text x="200" y="226" text-anchor="middle" class="lbl">Local hub</text>
    <text x="200" y="244" text-anchor="middle" class="sub2">co-located · always running</text>
    <text x="200" y="266" text-anchor="middle" class="badge">SQLite DB · routers</text>

    <!-- REMOTE A -->
    <rect x="390" y="198" width="220" height="86" rx="12" fill="none" stroke="var(--remote)" stroke-width="2"/>
    <text x="500" y="226" text-anchor="middle" class="lbl">Remote hub A</text>
    <text x="500" y="244" text-anchor="middle" class="sub2">self-hosted · default*</text>
    <text x="500" y="266" text-anchor="middle" class="badge">own DB · TLS · BetterAuth</text>

    <!-- REMOTE B -->
    <rect x="690" y="198" width="220" height="86" rx="12" fill="none" stroke="var(--remote)" stroke-width="2"/>
    <text x="800" y="226" text-anchor="middle" class="lbl">Remote hub B …</text>
    <text x="800" y="244" text-anchor="middle" class="sub2">any number</text>
    <text x="800" y="266" text-anchor="middle" class="badge">own DB · fully independent</text>

    <!-- edges hub -> runners (runners dial IN, arrow points to hub) -->
    <!-- local runner -->
    <path d="M200,416 L200,286" fill="none" stroke="var(--runner)" stroke-width="2" marker-end="url(#ar)"/>
    <text x="210" y="356" class="edgelbl">dials in · wss://…/fleet</text>
    <!-- hub A runners -->
    <path d="M470,416 C470,360 470,340 490,286" fill="none" stroke="var(--runner)" stroke-width="2" marker-end="url(#ar)"/>
    <path d="M540,416 C540,360 540,340 512,286" fill="none" stroke="var(--runner)" stroke-width="2" marker-end="url(#ar)"/>
    <!-- hub B runner -->
    <path d="M800,416 L800,286" fill="none" stroke="var(--runner)" stroke-width="2" marker-end="url(#ar)"/>

    <!-- ================= RUNNERS ================= -->
    <rect x="120" y="418" width="160" height="66" rx="12" fill="none" stroke="var(--runner)" stroke-width="2"/>
    <text x="200" y="446" text-anchor="middle" class="lbl">Local runner</text>
    <text x="200" y="466" text-anchor="middle" class="sub2">pty · git · fs</text>

    <rect x="410" y="418" width="80" height="66" rx="12" fill="none" stroke="var(--runner)" stroke-width="2"/>
    <text x="450" y="450" text-anchor="middle" class="lbl">R</text>
    <text x="450" y="468" text-anchor="middle" class="sub2">exec</text>
    <rect x="500" y="418" width="80" height="66" rx="12" fill="none" stroke="var(--runner)" stroke-width="2"/>
    <text x="540" y="450" text-anchor="middle" class="lbl">R</text>
    <text x="540" y="468" text-anchor="middle" class="sub2">exec</text>

    <rect x="720" y="418" width="160" height="66" rx="12" fill="none" stroke="var(--runner)" stroke-width="2"/>
    <text x="800" y="446" text-anchor="middle" class="lbl">Runner(s)</text>
    <text x="800" y="466" text-anchor="middle" class="sub2">exec only</text>

    <!-- footnote -->
    <text x="500" y="524" text-anchor="middle" class="sub2">A project lives on exactly one hub (its DB). Click it → board, tasks &amp; terminals talk to that hub.</text>
    <text x="500" y="540" text-anchor="middle" class="sub2">* default hub = where new projects are created.</text>
  </svg>

  <div class="legend">
    <span><i class="key" style="background:var(--client)"></i>Client (1)</span>
    <span><i class="key" style="background:var(--local)"></i>Local hub</span>
    <span><i class="key" style="background:var(--remote)"></i>Remote hub</span>
    <span><i class="key" style="background:var(--runner)"></i>Runner</span>
    <span><i class="sw" style="border-color:var(--remote)"></i>client → hub (tRPC)</span>
    <span><i class="sw" style="border-color:var(--runner)"></i>runner → hub (fleet)</span>
  </div>
</div>
</body>
</html>
