flowchart TD
    subgraph main["Electron Main Thread"]
        ipc["ipcMain.handle 200+ handlers async"]
        rest["Express REST API async"]
        handlers["Domain Handlers\nawait db.get / all / run\nawait db.batchTxn / namedTxn"]
        bridge["DbBridge async proxy"]
        ipc --> handlers
        rest --> handlers
        handlers --> bridge
    end

    subgraph worker["DB Worker Thread"]
        loop["Message loop"]
        txnreg["txn-registry.ts\nchat-queue push / pop / requeue"]
        migrunner["Startup: legacy migration\npragmas, backup, runMigrations\nnormalizations, ready"]
        bsq["better-sqlite3 single connection"]
        loop --> txnreg
        loop --> bsq
        migrunner --> bsq
    end

    subgraph diagworker["Diag Worker Thread"]
        diagloop["Message loop"]
        diagbsq["better-sqlite3 diag connection"]
        diagloop --> diagbsq
        diagbsq --> diagfile[("diagnostics.sqlite")]
    end

    subgraph cli["CLI separate process unchanged"]
        clidb["node:sqlite DatabaseSync"]
        notify["POST /api/notify"]
        clidb --> notify
    end

    bridge <-->|MessageChannel| loop
    main -->|DiagBridge| diagloop
    bsq --> mainfile[("slayzone.sqlite")]
    notify --> rest
    clidb --> mainfile
