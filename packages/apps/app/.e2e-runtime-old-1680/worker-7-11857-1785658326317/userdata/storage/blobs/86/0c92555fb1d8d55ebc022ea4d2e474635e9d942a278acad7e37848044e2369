graph LR
  classDef spine fill:#1f2937,stroke:#9ca3af,color:#fff;
  classDef crm fill:#0e7490,stroke:#67e8f9,color:#fff;
  classDef cs fill:#15803d,stroke:#86efac,color:#fff;
  classDef comp fill:#b45309,stroke:#fcd34d,color:#fff;

  subgraph SPINE[Shared spine - governance metadata]
    A[Account]:::spine
    C[Contact]:::spine
    TM[TeamMember]:::spine
    R["Review\n(approval event -> freshness)"]:::spine
  end

  subgraph CRM[CRM docs]
    AP["AccountPlan\n(draft->active->archived)"]:::crm
    MN["MeetingNote\n(record)"]:::crm
    PR["Proposal\n(draft->sent->accepted/rejected)"]:::crm
  end

  subgraph CS[Customer Success docs]
    PB["Playbook\n(draft->review->published->archived)"]:::cs
    OB["OnboardingPlan\n(per-account)"]:::cs
    KB["KBArticle\n(draft->review->published->archived, decay)"]:::cs
  end

  subgraph COMP[Compliance docs]
    PO["Policy\n(draft->review->approved->published, review_due)"]:::comp
    AG["Agreement MSA/DPA/NDA/SOW\n(draft->active->expired)"]:::comp
    CT["Control + evidence\n(not_impl->implemented->verified)"]:::comp
    AU["AuditReport\n(planned->in_progress->complete)"]:::comp
  end

  C -->|works_at| A
  AP -->|for| A
  AP -->|owner| TM
  MN -->|about| A
  MN -->|with| C
  PR -->|for| A
  OB -->|for| A
  OB -->|owner| TM
  PB -->|owner| TM
  KB -->|owner| TM
  PO -->|owner| TM
  AG -->|for| A
  AG -->|signed_by| C
  CT -->|owner| TM
  AU -->|covers| CT
  R -->|by| TM
  R -.->|of any document| PO
  R -.->|of any document| AG
  R -.->|of any document| KB
