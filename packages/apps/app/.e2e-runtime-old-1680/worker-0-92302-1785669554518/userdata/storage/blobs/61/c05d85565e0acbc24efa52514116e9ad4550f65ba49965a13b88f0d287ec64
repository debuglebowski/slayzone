## Migration recipe (fill in P2)

```tsx
// BEFORE
function useFoo(id: string) {
  const [data, setData] = useState<Foo | null>(null);
  useEffect(() => {
    let alive = true;
    getTrpcVanillaClient().foo.get.query({ id }).then((res) => {
      if (alive) setData(res);
    });
    return () => { alive = false; };
  }, [id]);
  return data;
}

// AFTER
import { useQuery } from '@tanstack/react-query';
import { useTRPC } from '@slayzone/transport/client';

function useFoo(id: string) {
  const trpc = useTRPC();
  const { data } = useQuery(trpc.foo.get.queryOptions({ id }));
  return data ?? null;
}
```

For mutations:
```tsx
const trpc = useTRPC();
const queryClient = useQueryClient();
const updateFoo = useMutation(trpc.foo.update.mutationOptions({
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: trpc.foo.get.queryKey() });
  },
}));
// updateFoo.mutate({ id, ... })
```

For subscriptions (PTY-style streaming):
```tsx
const trpc = useTRPC();
useSubscription(trpc.terminal.onData.subscriptionOptions(
  { sessionId },
  { onData: (chunk) => writeToXterm(chunk) },
));
```

