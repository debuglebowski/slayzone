### Verification commands

```bash
# Workspace typecheck (parallel, no-bail)
pnpm -r --workspace-concurrency=4 --no-bail typecheck

# E2E (requires build first)
pnpm build && pnpm test:e2e

# Imperative-call audit (the metric Phase 6.1 used)
node -e '
const fs = require("fs"); const { execSync } = require("child_process");
const files = execSync("find packages/domains/*/src/client packages/apps/app/src/renderer -type f \\( -name \"*.ts\" -o -name \"*.tsx\" \\) 2>/dev/null", { encoding: "utf8" }).trim().split("\n").filter(Boolean);
let total = 0;
for (const f of files) {
  if (f.endsWith(".test.ts") || f.endsWith(".test.tsx")) continue;
  const src = fs.readFileSync(f, "utf8");
  if (!/useTRPCClient\(\)/.test(src)) continue;
  const lines = src.split("\n");
  let depth = 0, modeDepth = 0, mode = null;
  for (const line of lines) {
    if (mode === null && /\buseEffect\s*\(/.test(line)) { mode = "effect"; modeDepth = depth }
    for (const ch of line) {
      if (ch === "{") depth++;
      else if (ch === "}") { depth--; if (mode && depth <= modeDepth) mode = null }
    }
    if (mode === "effect") {
      const m = line.match(/[a-zA-Z_$][\w$]*(?:\.[a-zA-Z_$][\w$]*)+\.(query|mutate|subscribe)\(/g);
      if (m) total += m.length;
    }
  }
}
console.log(`useEffect-imperative: ${total}`);
'
```

## Patterns established (apply uniformly)

These patterns are now consistent across ~70 converted files. Use them in 6.2:

```tsx
// useEffect+query → useQuery
const { data } = useQuery(trpc.x.y.queryOptions(input))

// Conditional fetch → enabled flag
const { data } = useQuery({ ...trpc.x.y.queryOptions(input ?? defaultInput), enabled: !!input })

// Polling → refetchInterval
const { data } = useQuery({
  ...trpc.x.y.queryOptions(input),
  enabled: visible,
  refetchInterval: visible ? 5000 : false,
})

// Subscription onData → invalidate
useSubscription(trpc.x.onChanged.subscriptionOptions(undefined, {
  onData: () => queryClient.invalidateQueries({ queryKey: trpc.x.y.queryKey() }),
}))

// Mutation with refresh → useMutation w/ onSuccess
const m = useMutation(trpc.x.update.mutationOptions({
  onSuccess: () => queryClient.invalidateQueries({ queryKey: trpc.x.list.queryKey() }),
}))

// Settings (per-key)
import { useSetting, useSetSettingMutation } from '@slayzone/settings/client'
const value = useSetting(key)         // returns string | null | undefined
const setSetting = useSetSettingMutation()
setSetting.mutate({ key, value })

// Settings (batch)
import { useSettings } from '@slayzone/settings/client'
const KEYS = ['k1', 'k2', 'k3'] as const
const s = useSettings(KEYS)            // s.k1, s.k2, s.k3

// Imperative inside event handler / sequential pipeline → fetchQuery (legitimate)
const data = await queryClient.fetchQuery(trpc.x.y.queryOptions(input))
```

