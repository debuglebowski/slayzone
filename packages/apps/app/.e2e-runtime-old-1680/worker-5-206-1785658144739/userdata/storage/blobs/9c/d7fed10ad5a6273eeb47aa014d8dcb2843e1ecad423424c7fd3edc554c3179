flowchart TB
    subgraph TODAY["Today — Electron-coupled"]
        R1[Renderer React]
        P1[Preload window.api.*]
        M1[Electron main]
        IPC[ipcMain handlers]
        D1[Domain logic<br/>imports electron]
        DB1[(SQLite)]
        R1 --> P1 --> IPC --> M1 --> D1 --> DB1
    end

    subgraph END["End state — server pkg, two host modes"]
        direction TB

        subgraph LOCAL["Local mode (embedded)"]
            RL[Renderer React]
            EL[Electron main<br/>thin wrapper]
            SL["@slayzone/server<br/>embedded"]
            DBL[(SQLite)]
            RL -- "tRPC/WS<br/>ws://localhost" --> SL
            EL -. embeds .-> SL
            SL --> DBL
        end

        subgraph REMOTE["Remote mode (hosted)"]
            RR[Renderer React]
            SR["@slayzone/server<br/>plain Node"]
            DBR[(SQLite / Postgres)]
            RR -- "tRPC/WS<br/>wss://host" --> SR
            SR --> DBR
        end

        ELECTRON_ONLY[Electron-only features<br/>browser panel, menus,<br/>dialogs, tray]
        EL -. exposes .-> ELECTRON_ONLY
    end

