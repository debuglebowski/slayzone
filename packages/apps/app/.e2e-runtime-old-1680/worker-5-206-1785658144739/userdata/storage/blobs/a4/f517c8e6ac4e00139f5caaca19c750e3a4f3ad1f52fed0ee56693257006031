<!doctype html>
<html lang="en" data-mode="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>biotracker — screen mockups</title>
<style>
  /* ============================================================
     DESIGN TOKENS — mirrors src/ui/theme/index.tsx (current app)
     Swap these values for the retake; every frame updates.
     ============================================================ */
  :root[data-mode="light"] {
    --primary:      #2f5061;
    --primaryTint:  #4297a0;
    --accent:       #2f5061;   /* NOTE: == primary in light mode */
    --secondary:    #e57f84;
    --error:        #fd3d3d;
    --divider:      rgba(0,0,0,0.2);
    --background:   #f4eae6;
    --text-body:    rgba(0,0,0,0.67);
    --text-label:   rgba(0,0,0,0.4);
    --input:        rgba(255,255,255,0.2);   /* near-invisible on bg */
    --card:         rgba(255,255,255,0.1);   /* near-invisible on bg */
    --shadow:       rgba(0,0,0,0.15);
    --on-primary:   #ffffff;
  }
  :root[data-mode="dark"] {
    --primary:      #2f5061;
    --primaryTint:  #4297a0;
    --accent:       #5f9fc4;
    --secondary:    #e57f84;
    --error:        #fd3d3d;
    --divider:      rgba(255,255,255,0.15);
    --background:   #1b1918;
    --text-body:    rgba(255,255,255,0.87);
    --text-label:   rgba(255,255,255,0.5);
    --input:        rgba(255,255,255,0.08);
    --card:         rgba(255,255,255,0.06);
    --shadow:       rgba(0,0,0,0.4);
    --on-primary:   #ffffff;
  }

  /* ---- page chrome (not part of the app) ---- */
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #2a2a2e;
    color: #ddd;
  }
  .toolbar {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; gap: 16px;
    padding: 14px 24px;
    background: #17171a; border-bottom: 1px solid #333;
  }
  .toolbar h1 { font-size: 15px; margin: 0; font-weight: 600; letter-spacing: .3px; }
  .toolbar .spacer { flex: 1; }
  .toolbar button {
    font: inherit; font-size: 13px;
    background: #2f5061; color: #fff; border: none;
    padding: 7px 16px; border-radius: 8px; cursor: pointer;
  }
  .toolbar button.alt { background: #3a3a40; }
  .gallery {
    display: flex; flex-wrap: wrap; gap: 32px;
    padding: 32px; align-items: flex-start; justify-content: center;
  }
  .frame-wrap { display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .frame-label { font-size: 12px; color: #999; letter-spacing: .5px; text-transform: uppercase; }

  /* ---- device frame ---- */
  .device {
    width: 300px; height: 620px;
    border-radius: 40px;
    background: #000; padding: 10px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    position: relative;
  }
  .screen {
    width: 100%; height: 100%;
    border-radius: 30px; overflow: hidden;
    background: var(--background);
    color: var(--text-body);
    display: flex; flex-direction: column;
    position: relative;
    font-size: 14px;
  }
  .notch {
    position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
    width: 110px; height: 22px; background: #000; border-radius: 12px; z-index: 20;
  }

  /* ---- app shell ---- */
  .statusbar { height: 40px; flex: none; }
  .header {
    display: flex; align-items: center; gap: 10px;
    padding: 4px 16px 12px; flex: none;
  }
  .header .back { font-size: 20px; color: var(--text-body); width: 22px; }
  .header .title { font-size: 17px; font-weight: 700; color: var(--text-body); }
  .header .wordmark {
    font-family: "Cochin", Georgia, serif; font-size: 20px; color: var(--secondary); font-weight: 600;
  }
  .header .spacer { flex: 1; }
  .header .icon-btn {
    width: 30px; height: 30px; border-radius: 15px;
    display: grid; place-items: center; color: var(--text-body); font-size: 18px;
  }
  .body { flex: 1; overflow: hidden; padding: 12px 16px; }
  .scroll { height: 100%; overflow: auto; }

  .section-title {
    font-size: 11px; font-weight: 700; letter-spacing: .8px;
    color: var(--text-label); text-transform: uppercase;
    margin: 14px 4px 8px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--divider);
    border-radius: 12px; overflow: hidden;
  }
  .row {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 14px;
  }
  .row + .row { border-top: 1px solid var(--divider); }
  .row .lead { color: var(--text-body); flex: 1; }
  .row .val { color: var(--text-label); font-size: 13px; }
  .row .chev { color: var(--text-label); font-size: 16px; }
  .row .rowicon {
    width: 22px; color: var(--primaryTint); font-size: 16px; text-align: center;
  }

  .banner {
    background: rgba(229,127,132,0.18);
    border: 1px solid var(--secondary);
    border-radius: 12px; padding: 12px 14px;
    color: var(--text-body); font-size: 13px; line-height: 1.4;
    display: flex; gap: 10px; margin-bottom: 6px;
  }
  .banner .warn { color: var(--secondary); font-size: 16px; }

  .fab {
    position: absolute; right: 16px; bottom: 78px;
    width: 56px; height: 56px; border-radius: 28px;
    background: var(--primary); color: #fff;
    display: grid; place-items: center; font-size: 30px;
    box-shadow: 0 6px 16px var(--shadow); z-index: 15;
  }

  .tabbar {
    height: 62px; flex: none;
    border-top: 2px solid var(--divider);
    background: var(--background);
    display: flex;
  }
  .tab {
    flex: 1; display: flex; flex-direction: column; gap: 3px;
    align-items: center; justify-content: center;
    font-size: 11px; color: var(--text-label);
  }
  .tab .ic { font-size: 20px; }
  .tab.active { color: var(--accent); }

  /* ---- form bits ---- */
  .label { font-size: 12px; font-weight: 700; color: var(--text-label); margin: 14px 0 4px; }
  .field {
    background: var(--input);
    border: 1px solid var(--divider);
    border-radius: 12px; padding: 12px 12px;
    color: var(--text-body); font-size: 15px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .field .ph { color: var(--text-label); }
  .divider-line { height: 1px; background: var(--divider); margin: 14px 0; }
  .btn {
    height: 48px; border-radius: 24px;
    display: grid; place-items: center;
    font-weight: 600; font-size: 15px; margin-top: 16px;
  }
  .btn.primary { background: var(--primary); color: var(--on-primary); }
  .btn.danger  { background: transparent; color: var(--error); border: 1px solid var(--error); }

  /* ---- charts ---- */
  .btngroup { display: flex; border: 1px solid var(--divider); border-radius: 10px; overflow: hidden; }
  .btngroup > div {
    flex: 1; padding: 10px 6px; text-align: center; font-size: 12px; color: var(--text-body);
    background: var(--card); display: flex; gap: 5px; align-items: center; justify-content: center;
  }
  .btngroup > div + div { border-left: 1px solid var(--divider); }
  .chartbox {
    margin-top: 14px; background: var(--card);
    border: 1px solid var(--divider); border-radius: 12px; padding: 12px;
  }

  /* ---- rating / segmented ---- */
  .stars { font-size: 22px; letter-spacing: 4px; color: var(--primaryTint); }
  .stars .off { color: var(--text-label); }
  .dots { display: flex; gap: 8px; justify-content: center; margin: 18px 0; }
  .dots span { width: 9px; height: 9px; border-radius: 5px; background: var(--text-label); opacity: .4; }
  .dots span.on { background: var(--primary); opacity: 1; }

  .empty { text-align: center; color: var(--text-label); padding: 40px 20px; }
  .empty .t { font-weight: 600; color: var(--text-body); margin-bottom: 6px; }

  .center-prompt { text-align: center; margin-top: 30px; }
  .center-prompt .cat { font-size: 11px; letter-spacing: .8px; color: var(--text-label); text-transform: uppercase; }
  .center-prompt .dp { font-size: 20px; font-weight: 700; margin-top: 4px; color: var(--text-body); }
  .big-input {
    margin: 24px auto 0; width: 70%;
    background: var(--input); border: 1px solid var(--divider);
    border-radius: 12px; padding: 16px; text-align: center; font-size: 22px; color: var(--text-body);
  }
  .navrow { display: flex; gap: 12px; padding: 14px 16px; flex: none; }
  .navrow .btn { flex: 1; margin: 0; }
  .btn.ghost { background: var(--card); color: var(--text-body); border: 1px solid var(--divider); }
</style>
</head>
<body>
  <div class="toolbar">
    <h1>biotracker · screen mockups</h1>
    <span style="font-size:12px;color:#888">current tokens (src/ui/theme) — baseline for retake</span>
    <span class="spacer"></span>
    <button id="modeBtn" onclick="toggleMode()">◐ Toggle dark</button>
  </div>

  <div class="gallery" id="gallery"></div>

<script>
/* Each screen returns inner-.screen HTML. Frames are cloned per screen. */
const wordmark = '<span class="wordmark">biotracker</span>';

const tabbar = (active) => `
  <div class="tabbar">
    <div class="tab ${active==='input'?'active':''}"><span class="ic">⌨</span>Input</div>
    <div class="tab ${active==='charts'?'active':''}"><span class="ic">📈</span>Charts</div>
  </div>`;

const statusHeader = (inner) => `<div class="statusbar"></div>${inner}`;

const screens = {

/* 01 ------------------------------------------------------------ */
"01 · input home": statusHeader(`
  <div class="header">${wordmark}<span class="spacer"></span>
    <div class="icon-btn">＋</div></div>
  <div class="body"><div class="scroll">
    <div class="banner"><span class="warn">⚠</span>
      <div>Enable notifications to send your scheduled reminders. Tap to open settings.</div></div>

    <div class="section-title">Sleep</div>
    <div class="card">
      <div class="row"><span class="lead">Hours slept</span><span class="chev">›</span></div>
      <div class="row"><span class="lead">Sleep quality</span><span class="chev">›</span></div>
    </div>

    <div class="section-title">Mood</div>
    <div class="card">
      <div class="row"><span class="lead">Overall mood</span><span class="chev">›</span></div>
      <div class="row"><span class="lead">Energy</span><span class="chev">›</span></div>
    </div>
  </div></div>
  <div class="fab">＋</div>
  ${tabbar('input')}
`),

/* 02 ------------------------------------------------------------ */
"02 · input entry-list": statusHeader(`
  <div class="header"><span class="back">‹</span><span class="title">Hours slept</span>
    <span class="spacer"></span><div class="icon-btn">＋</div></div>
  <div style="text-align:center;color:var(--text-label);font-size:13px;padding-bottom:10px">
    ◀&nbsp;&nbsp;Sat, Jul 12&nbsp;&nbsp;▶</div>
  <div class="body"><div class="scroll">
    <div class="card">
      <div class="row"><span class="lead">7.5 h</span><span class="val">09:14</span><span class="chev">›</span></div>
      <div class="row"><span class="lead">8.0 h</span><span class="val">23:40</span><span class="chev">›</span></div>
    </div>
  </div></div>
  ${tabbar('input')}
`),

/* 03 ------------------------------------------------------------ */
"03 · input entry-all": statusHeader(`
  <div class="header"><span class="back">‹</span><span class="title">Log entries</span></div>
  <div class="body">
    <div class="center-prompt">
      <div class="cat">Sleep</div><div class="dp">Hours slept</div>
    </div>
    <div class="big-input">7.5 <span style="font-size:15px;color:var(--text-label)">h</span></div>
    <div class="dots"><span class="on"></span><span class="on"></span><span class="on"></span><span></span><span></span></div>
    <div style="text-align:center;color:var(--text-label);font-size:12px">3 of 5</div>
  </div>
  <div class="navrow">
    <div class="btn ghost">Skip</div>
    <div class="btn primary">Next</div>
  </div>
`),

/* 04 ------------------------------------------------------------ */
"04 · charts": statusHeader(`
  <div class="header">${wordmark}<span class="spacer"></span><div class="icon-btn">＋</div></div>
  <div class="body"><div class="scroll">
    <div class="btngroup">
      <div>📊 Sleep</div><div>📅 Range</div><div>⧗ Interval</div>
    </div>
    <div class="chartbox">
      <svg viewBox="0 0 240 130" width="100%" height="150">
        <g stroke="var(--divider)" stroke-width="1">
          <line x1="24" y1="10"  x2="240" y2="10"/>
          <line x1="24" y1="45"  x2="240" y2="45"/>
          <line x1="24" y1="80"  x2="240" y2="80"/>
          <line x1="24" y1="112" x2="240" y2="112"/>
        </g>
        <g fill="var(--text-label)" font-size="9">
          <text x="6" y="14">8</text><text x="6" y="49">6</text>
          <text x="6" y="84">4</text><text x="6" y="116">2</text>
        </g>
        <polyline fill="none" stroke="var(--primaryTint)" stroke-width="2.5"
          points="30,95 70,60 110,30 150,55 190,40 226,70"/>
        <g fill="var(--primary)">
          <circle cx="30" cy="95" r="3"/><circle cx="70" cy="60" r="3"/>
          <circle cx="110" cy="30" r="3"/><circle cx="150" cy="55" r="3"/>
          <circle cx="190" cy="40" r="3"/><circle cx="226" cy="70" r="3"/>
        </g>
        <g fill="var(--text-label)" font-size="8">
          <text x="24" y="126">Mon</text><text x="66" y="126">Tue</text>
          <text x="108" y="126">Wed</text><text x="150" y="126">Thu</text><text x="192" y="126">Fri</text>
        </g>
      </svg>
    </div>
  </div></div>
  ${tabbar('charts')}
`),

/* 05 ------------------------------------------------------------ */
"05 · settings home": statusHeader(`
  <div class="header"><span class="back">‹</span><span class="title">Settings</span></div>
  <div class="body"><div class="scroll">
    <div class="section-title">General</div>
    <div class="card"><div class="row"><span class="rowicon">◐</span><span class="lead">Appearance</span><span class="chev">›</span></div></div>

    <div class="section-title">Input</div>
    <div class="card">
      <div class="row"><span class="rowicon">◇</span><span class="lead">Categories</span><span class="chev">›</span></div>
      <div class="row"><span class="rowicon">⦿</span><span class="lead">Datapoints</span><span class="chev">›</span></div>
    </div>

    <div class="section-title">Charts</div>
    <div class="card"><div class="row"><span class="rowicon">▤</span><span class="lead">Charts</span><span class="chev">›</span></div></div>

    <div class="section-title">Notifications</div>
    <div class="card"><div class="row"><span class="rowicon">🔔</span><span class="lead">Notifications</span><span class="chev">›</span></div></div>

    <div class="section-title">Account</div>
    <div class="card"><div class="row"><span class="rowicon" style="color:var(--error)">🗑</span><span class="lead" style="color:var(--error)">Delete account</span></div></div>
  </div></div>
`),

/* 06 ------------------------------------------------------------ */
"06 · settings list": statusHeader(`
  <div class="header"><span class="back">‹</span><span class="title">Datapoints</span>
    <span class="spacer"></span><div class="icon-btn">＋</div></div>
  <div class="body"><div class="scroll">
    <div class="section-title">Sleep</div>
    <div class="card">
      <div class="row"><span class="lead">Hours slept</span><span class="chev">›</span></div>
      <div class="row"><span class="lead">Sleep quality</span><span class="chev">›</span></div>
    </div>
    <div class="section-title">Mood</div>
    <div class="card">
      <div class="row"><span class="lead">Overall mood</span><span class="chev">›</span></div>
    </div>
  </div></div>
`),

/* 07 ------------------------------------------------------------ */
"07 · settings one": statusHeader(`
  <div class="header"><span class="back">‹</span><span class="title">Edit datapoint</span>
    <span class="spacer"></span><div class="icon-btn" style="color:var(--accent);font-weight:600;font-size:14px">Save</div></div>
  <div class="body"><div class="scroll">
    <div class="label">Name</div>
    <div class="field">Hours slept</div>
    <div class="label">Category</div>
    <div class="field">Sleep <span class="ph">▾</span></div>
    <div class="label">Type</div>
    <div class="field">Number <span class="ph">▾</span></div>
    <div class="label">Unit</div>
    <div class="field">h</div>
    <div class="btn primary">Save</div>
    <div class="btn danger">Delete</div>
  </div></div>
`),

};

const gallery = document.getElementById('gallery');
for (const [label, html] of Object.entries(screens)) {
  const wrap = document.createElement('div');
  wrap.className = 'frame-wrap';
  wrap.innerHTML = `
    <div class="device"><div class="notch"></div><div class="screen">${html}</div></div>
    <div class="frame-label">${label}</div>`;
  gallery.appendChild(wrap);
}

function toggleMode(){
  const r = document.documentElement;
  const next = r.getAttribute('data-mode') === 'light' ? 'dark' : 'light';
  r.setAttribute('data-mode', next);
  document.getElementById('modeBtn').textContent = next === 'light' ? '◐ Toggle dark' : '◑ Toggle light';
}
</script>
</body>
</html>
