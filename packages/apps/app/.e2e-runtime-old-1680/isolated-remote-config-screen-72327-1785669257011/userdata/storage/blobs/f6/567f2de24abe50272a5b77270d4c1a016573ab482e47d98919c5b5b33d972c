flowchart TD
    SQLiteFile[("slayzone.dev.sqlite")]

    subgraph Main["Electron Main Thread - blocking"]
        IPC["ipcMain.handle\n200+ handlers"]
        REST["Express REST API\n/api/notify, /api/tasks"]
        Handlers["Domain Handlers\ntask, settings, tags, integrations\nchat-queue, automations, ai-config"]
        DB["better-sqlite3\nSingleton - SYNCHRONOUS\nBlocks main thread on every call"]

        IPC -->|sync call| Handlers
        REST -->|sync call| Handlers
        Handlers -->|db.prepare().get/run/all| DB
    end

    subgraph DiagDB["Diagnostics - same thread"]
        DiagConn["better-sqlite3\ndiag singleton"]
        DiagFile[("slayzone.dev.diagnostics.sqlite")]
        DiagConn --> DiagFile
    end

    DB -->|WAL| SQLiteFile
    Handlers -->|batch insert| DiagConn

    subgraph CLI["CLI - separate process"]
        CLIDb["node:sqlite\nDatabaseSync"]
        Notify["POST /api/notify"]
        CLIDb -->|close first| Notify
    end

    Notify -->|HTTP| REST
    CLIDb -->|direct WAL write| SQLiteFile
