flowchart LR
    Renderer["<b>Renderer</b><br/>(React)"]
    Electron["<b>Electron host</b><br/>@slayzone/app<br/>━━━━━━━━<br/>in-process tRPC<br/>(unchanged)"]
    SideCar["<b>Side-car</b><br/>@slayzone/server<br/>━━━━━━━━<br/>shadow infra<br/>spawned + supervised<br/>/trpc + /health<br/>NO consumers yet"]
    DB[("<b>SQLite (WAL)</b><br/>two writers serialized<br/>━━━━━━━━<br/>typed by <i>SlayzoneDb</i>")]

    Renderer == "tRPC (in-process)<br/><i>AppRouter</i>" ==> Electron
    Renderer -. "legacy IPC<br/><i>ElectronAPI</i>" .-> Electron
    Electron -- "spawns + supervises<br/>+ /health poll" --> SideCar
    Electron -- "writer" --> DB
    SideCar -- "writer (idle —<br/>empty router)" --> DB

    Renderer -. "slice 2.6 cutover<br/>(future)" .-x SideCar

    classDef new fill:#1e3a5f,stroke:#4a9eff,stroke-width:2px,color:#fff
