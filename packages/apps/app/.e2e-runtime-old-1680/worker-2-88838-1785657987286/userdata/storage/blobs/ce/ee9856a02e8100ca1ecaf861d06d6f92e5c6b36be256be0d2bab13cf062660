flowchart TD
    START([slayzone-runner boot]) --> G{"canPrompt?<br/>stdin.isTTY AND not SUPERVISED<br/>AND not NONINTERACTIVE"}
    G -- no --> SKIP["skip setup →<br/>loadRunnerConfig<br/>(fail-fast if no token)"]

    G -- yes --> R1{"joinToken set?<br/>(env / config.json)"}
    R1 -- yes --> SKIP
    R1 -- no --> R2{"hubUrl known<br/>AND creds stored?"}
    R2 -- yes --> SKIP

    R2 -- no --> Q1["ask: Hub join token"]
    Q1 --> Q2["ask: allowedRoots<br/>(default = launch dir)"]
    Q2 --> Q3["ask: display name<br/>(hint = hostname)"]

    Q3 --> J1{"token empty?"}
    J1 -- yes --> DROP1["drop field"]
    J1 -- no --> C1["collect joinToken"]
    DROP1 --> J2
    C1 --> J2{"roots empty?"}
    J2 -- yes --> C2["collect default root"]
    J2 -- no --> C2b["split/trim → collect roots[]"]
    C2 --> J3
    C2b --> J3{"name empty?"}
    J3 -- yes --> DROP3["drop → live hostname each boot"]
    J3 -- no --> C3["collect runnerName"]

    DROP3 --> ANY
    C3 --> ANY{"any collected?"}
    ANY -- no --> SKIP
    ANY -- yes --> SEED["seed process.env"]
    SEED --> SUM["print summary"]
    SUM --> CONF{"Save to config.json?<br/>[Y/n] (Enter=yes)"}
    CONF -- yes --> WRITE["updateSlayzoneConfig()<br/>atomic 0600 merge"]
    CONF -- no --> RUNONLY["run-only (not persisted)"]

    WRITE --> BOOT([loadRunnerConfig → startRunner])
    RUNONLY --> BOOT
    SKIP --> BOOT
