<!DOCTYPE html><html><body>
      <canvas id="c" width="50" height="50"></canvas>
      <div id="ok">no</div>
      <script>
        const ctx = document.getElementById('c').getContext('2d');
        ctx.fillStyle = '#ff0000';
        ctx.fillRect(0, 0, 50, 50);
        document.getElementById('ok').textContent = 'yes';
      </script>
    </body></html>