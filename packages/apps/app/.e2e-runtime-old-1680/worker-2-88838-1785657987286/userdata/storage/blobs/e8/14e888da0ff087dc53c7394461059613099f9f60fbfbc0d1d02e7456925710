<!doctype html>
<html lang="en" data-mode="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>biotracker — Refined Warm</title>
<style>
  /* ============================================================
     RETAKE A · REFINED WARM
     Evolves the current brand. Warm paper, slate ink, coral as the
     single action color. Solid cards + soft shadow. Cochin headers.
     Chart color validated: coral #e5675c passes on light surface.
     ============================================================ */
  :root[data-mode="light"] {
    --bg:            #f4ece7;   /* warm paper */
    --bg-elev:       #faf5f1;   /* raised sections */
    --card:          #ffffff;   /* SOLID cards (was translucent) */
    --card-sunken:   #f1e9e3;   /* inputs / wells */
    --ink:           #24303a;   /* slate, near-black */
    --ink-soft:      #4a5a66;
    --ink-mut:       #8a8079;   /* warm grey labels */
    --line:          #e7ddd5;   /* hairline dividers */
    --line-strong:   #d8cabf;
    --brand:         #2f5061;   /* slate — identity, headers */
    --act:           #e5675c;   /* coral — the ONE action color */
    --act-ink:       #ffffff;
    --act-soft:      #fbe7e4;   /* coral wash */
    --good:          #4f9d7f;
    --warn:          #d98b3a;
    --chart:         #e5675c;   /* validated coral */
    --chart-2:       #2f5061;
    --shadow:        0 1px 2px rgba(36,48,58,.06), 0 6px 20px rgba(36,48,58,.08);
    --shadow-fab:    0 6px 16px rgba(229,103,92,.45);
  }
  :root[data-mode="dark"] {
    --bg:            #191614;
    --bg-elev:       #211d1a;
    --card:          #262019;
    --card-sunken:   #1f1a15;
    --ink:           #f3ece6;
    --ink-soft:      #cbbfb5;
    --ink-mut:       #948a80;
    --line:          #352d26;
    --line-strong:   #453b32;
    --brand:         #6fa3bd;
    --act:           #f0776c;
    --act-ink:       #2a0f0c;
    --act-soft:      #3a201d;
    --good:          #5cae8e;
    --warn:          #e0a05a;
    --chart:         #f0776c;
    --chart-2:       #6fa3bd;
    --shadow:        0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.4);
    --shadow-fab:    0 6px 18px rgba(0,0,0,.5);
  }
</style>
<style>
  /* shared skeleton — identical across all three retakes */
  * { box-sizing: border-box; }
  body { margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; background:#232326; color:#ddd; }
  .toolbar { position:sticky; top:0; z-index:50; display:flex; align-items:center; gap:16px; padding:14px 24px; background:#151517; border-bottom:1px solid #333; }
  .toolbar h1 { font-size:15px; margin:0; font-weight:600; letter-spacing:.3px; }
  .toolbar .sub { font-size:12px; color:#8a8a8a; }
  .toolbar .spacer { flex:1; }
  .toolbar button { font:inherit; font-size:13px; background:#e5675c; color:#fff; border:none; padding:7px 16px; border-radius:8px; cursor:pointer; }
  .gallery { display:flex; flex-wrap:wrap; gap:34px; padding:36px; align-items:flex-start; justify-content:center; }
  .frame-wrap { display:flex; flex-direction:column; gap:11px; align-items:center; }
  .frame-label { font-size:11px; color:#8a8a8a; letter-spacing:1px; text-transform:uppercase; }
  .device { width:308px; height:646px; border-radius:44px; background:#0a0a0a; padding:11px; box-shadow:0 24px 60px rgba(0,0,0,.55); position:relative; }
  .screen { width:100%; height:100%; border-radius:33px; overflow:hidden; background:var(--bg); color:var(--ink); display:flex; flex-direction:column; position:relative; font-size:14px; }
  .notch { position:absolute; top:11px; left:50%; transform:translateX(-50%); width:118px; height:24px; background:#0a0a0a; border-radius:13px; z-index:30; }

  .statusbar { height:44px; flex:none; display:flex; align-items:flex-end; justify-content:space-between; padding:0 22px 5px; font-size:12px; font-weight:600; color:var(--ink); }
  .statusbar .r { display:flex; gap:5px; align-items:center; }
  .body { flex:1; overflow:hidden; }
  .scroll { height:100%; overflow:auto; padding:6px 18px 20px; }
  .scroll::-webkit-scrollbar { display:none; }

  .tabbar { height:66px; flex:none; border-top:1px solid var(--line); background:var(--bg-elev); display:flex; padding-bottom:6px; }
  .tab { flex:1; display:flex; flex-direction:column; gap:4px; align-items:center; justify-content:center; font-size:11px; color:var(--ink-mut); font-weight:500; }
  .tab .ic { font-size:21px; line-height:1; }
  .tab.active { color:var(--act); }

  .fab { position:absolute; right:18px; bottom:84px; height:52px; border-radius:26px; padding:0 20px; background:var(--act); color:var(--act-ink); display:flex; align-items:center; gap:8px; font-weight:700; font-size:15px; box-shadow:var(--shadow-fab); z-index:20; }
  .fab .p { font-size:20px; }
</style>
<style>
  /* Refined-Warm-specific component styling */
  .apphead { display:flex; align-items:center; gap:10px; padding:8px 18px 10px; }
  .wordmark { font-family:"Cochin","Iowan Old Style",Georgia,serif; font-size:26px; color:var(--brand); letter-spacing:.3px; }
  .apphead .spacer { flex:1; }
  .apphead .iconbtn { width:38px; height:38px; border-radius:19px; background:var(--card); box-shadow:var(--shadow); display:grid; place-items:center; color:var(--brand); font-size:19px; }
  .stackhead { display:flex; align-items:center; gap:6px; padding:8px 18px 12px; }
  .stackhead .back { font-size:26px; color:var(--brand); width:24px; line-height:1; }
  .stackhead .title { font-family:"Cochin","Iowan Old Style",Georgia,serif; font-size:24px; color:var(--ink); }
  .stackhead .spacer { flex:1; }
  .stackhead .save { color:var(--act); font-weight:700; font-size:15px; }
  .stackhead .plus { width:36px; height:36px; border-radius:18px; background:var(--act-soft); color:var(--act); display:grid; place-items:center; font-size:20px; }

  .sectitle { font-size:11px; font-weight:700; letter-spacing:1.2px; color:var(--ink-mut); text-transform:uppercase; margin:20px 4px 9px; }
  .card { background:var(--card); border-radius:18px; box-shadow:var(--shadow); overflow:hidden; }
  .card + .card { margin-top:12px; }
  .prow { display:flex; align-items:center; gap:13px; padding:15px 16px; }
  .prow + .prow { border-top:1px solid var(--line); }
  .prow .lead { flex:1; }
  .prow .lead .t { font-weight:600; color:var(--ink); }
  .prow .lead .s { font-size:12px; color:var(--ink-mut); margin-top:2px; }
  .prow .big { font-size:20px; font-weight:700; color:var(--brand); font-variant-numeric:tabular-nums; }
  .prow .unit { font-size:12px; color:var(--ink-mut); font-weight:600; }
  .prow .chev { color:var(--line-strong); font-size:20px; }
  .prow .ic { width:34px; height:34px; border-radius:11px; background:var(--act-soft); color:var(--act); display:grid; place-items:center; font-size:16px; }
  .prow .val { color:var(--ink-mut); font-size:13px; font-variant-numeric:tabular-nums; }

  .spark { display:flex; align-items:flex-end; gap:3px; height:26px; }
  .spark i { width:5px; border-radius:2px; background:var(--act); opacity:.85; }

  .banner { display:flex; gap:11px; align-items:flex-start; background:var(--act-soft); border-radius:16px; padding:13px 15px; margin-top:8px; }
  .banner .i { color:var(--act); font-size:17px; }
  .banner .tx { font-size:13px; line-height:1.45; color:var(--ink-soft); }
  .banner .tx b { color:var(--ink); }

  .hero { background:var(--card); border-radius:20px; box-shadow:var(--shadow); padding:18px; margin-top:10px; }
  .hero .cap { font-size:11px; font-weight:700; letter-spacing:1px; color:var(--ink-mut); text-transform:uppercase; }
  .hero .row { display:flex; align-items:flex-end; justify-content:space-between; margin-top:6px; }
  .hero .num { font-size:34px; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums; letter-spacing:-.5px; }
  .hero .num small { font-size:16px; font-weight:600; color:var(--ink-mut); }
  .hero .delta { font-size:13px; font-weight:700; color:var(--good); }

  .label { font-size:12px; font-weight:700; color:var(--ink-mut); letter-spacing:.3px; margin:18px 2px 7px; text-transform:uppercase; }
  .field { background:var(--card-sunken); border:1px solid var(--line); border-radius:14px; padding:14px 14px; color:var(--ink); font-size:16px; display:flex; align-items:center; justify-content:space-between; }
  .field .ph { color:var(--ink-mut); }
  .field.focus { border-color:var(--act); background:var(--card); box-shadow:0 0 0 3px var(--act-soft); }
  .btn { height:52px; border-radius:26px; display:flex; align-items:center; justify-content:center; gap:8px; font-weight:700; font-size:16px; margin-top:16px; }
  .btn.primary { background:var(--act); color:var(--act-ink); box-shadow:var(--shadow-fab); }
  .btn.ghost { background:transparent; color:var(--ink-soft); border:1.5px solid var(--line-strong); }
  .btn.danger { background:transparent; color:var(--act); border:1.5px solid var(--act); box-shadow:none; }

  .seg { display:flex; background:var(--card-sunken); border-radius:13px; padding:4px; gap:4px; }
  .seg > div { flex:1; text-align:center; padding:9px 6px; font-size:13px; font-weight:600; color:var(--ink-soft); border-radius:10px; display:flex; align-items:center; justify-content:center; gap:6px; }
  .seg > div.on { background:var(--card); color:var(--brand); box-shadow:var(--shadow); }

  .chartcard { background:var(--card); border-radius:20px; box-shadow:var(--shadow); padding:16px; margin-top:12px; }
  .chartcard .ct { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
  .chartcard .ct .nm { font-weight:700; color:var(--ink); }
  .chartcard .ct .rg { font-size:12px; color:var(--ink-mut); }

  .stars { font-size:26px; letter-spacing:6px; color:var(--act); }
  .stars .off { color:var(--line-strong); }
  .dots { display:flex; gap:8px; justify-content:center; margin:22px 0 8px; }
  .dots span { width:8px; height:8px; border-radius:4px; background:var(--line-strong); }
  .dots span.on { background:var(--act); width:22px; }
  .center { text-align:center; margin-top:26px; }
  .center .cat { font-size:11px; letter-spacing:1.2px; color:var(--ink-mut); text-transform:uppercase; font-weight:700; }
  .center .dp { font-family:"Cochin",Georgia,serif; font-size:28px; color:var(--ink); margin-top:4px; }
  .biginput { margin:26px auto 0; width:78%; background:var(--card); box-shadow:var(--shadow); border-radius:18px; padding:22px; text-align:center; font-size:30px; font-weight:800; color:var(--brand); }
  .biginput small { font-size:16px; color:var(--ink-mut); font-weight:600; }
  .navrow { display:flex; gap:12px; padding:14px 18px 22px; }
  .navrow .btn { flex:1; margin:0; }
  .cal { display:flex; align-items:center; justify-content:center; gap:16px; color:var(--ink-soft); font-weight:600; font-size:14px; padding-bottom:8px; }
  .cal .a { color:var(--act); font-size:16px; }
  .empty { text-align:center; padding:36px 22px; }
  .empty .em { font-size:30px; }
  .empty .t { font-weight:700; color:var(--ink); margin:10px 0 4px; }
  .empty .s { font-size:13px; color:var(--ink-mut); line-height:1.4; }
</style>
</head>
<body data-palette="#e5675c,#2f5061">
  <div class="toolbar">
    <h1>Retake A · Refined Warm</h1>
    <span class="sub">warm paper · slate ink · coral action · solid cards</span>
    <span class="spacer"></span>
    <button onclick="tm()" id="mb">◐ Dark</button>
  </div>
  <div class="gallery" id="g"></div>

<script>
const sb = `<div class="statusbar"><span>9:41</span><span class="r">◍ ⌵ ▮</span></div>`;
const spark = (h)=>`<div class="spark">${h.map(v=>`<i style="height:${v}%"></i>`).join('')}</div>`;
const tab = (a)=>`<div class="tabbar">
  <div class="tab ${a=='i'?'active':''}"><span class="ic">✎</span>Input</div>
  <div class="tab ${a=='c'?'active':''}"><span class="ic">📈</span>Charts</div></div>`;

const S = {
"01 · input home": `${sb}
  <div class="apphead"><span class="wordmark">biotracker</span><span class="spacer"></span>
    <div class="iconbtn">☰</div></div>
  <div class="body"><div class="scroll">
    <div class="banner"><span class="i">🔔</span><span class="tx"><b>Turn on notifications</b> to get your scheduled reminders.</span></div>
    <div class="sectitle">Sleep</div>
    <div class="card">
      <div class="prow"><span class="ic">🌙</span><span class="lead"><div class="t">Hours slept</div><div class="s">Logged 7.5h today</div></span>${spark([40,55,45,70,60,80,65])}<span class="chev">›</span></div>
      <div class="prow"><span class="ic">✦</span><span class="lead"><div class="t">Sleep quality</div><div class="s">★★★★☆ today</div></span><span class="chev">›</span></div>
    </div>
    <div class="sectitle">Mood</div>
    <div class="card">
      <div class="prow"><span class="ic">☺</span><span class="lead"><div class="t">Overall mood</div><div class="s">Not logged today</div></span><span class="chev">›</span></div>
      <div class="prow"><span class="ic">⚡</span><span class="lead"><div class="t">Energy</div><div class="s">Logged 6/10 · 2h ago</div></span><span class="big">6<span class="unit">/10</span></span><span class="chev">›</span></div>
    </div>
  </div></div>
  <div class="fab"><span class="p">＋</span> Log</div>
  ${tab('i')}`,

"02 · entry list": `${sb}
  <div class="stackhead"><span class="back">‹</span><span class="title">Hours slept</span><span class="spacer"></span><div class="plus">＋</div></div>
  <div class="cal"><span class="a">◀</span> Sat, Jul 12 <span class="a">▶</span></div>
  <div class="body"><div class="scroll">
    <div class="hero"><div class="cap">Today</div><div class="row"><div class="num">7.5<small> h</small></div><div class="delta">▲ 0.4 vs avg</div></div></div>
    <div class="sectitle">Entries</div>
    <div class="card">
      <div class="prow"><span class="lead"><div class="t">7.5 h</div><div class="s">Morning</div></span><span class="val">09:14</span><span class="chev">›</span></div>
      <div class="prow"><span class="lead"><div class="t">8.0 h</div><div class="s">Nap</div></span><span class="val">14:40</span><span class="chev">›</span></div>
    </div>
  </div></div>
  ${tab('i')}`,

"03 · entry all": `${sb}
  <div class="stackhead"><span class="back">‹</span><span class="title">Log entries</span></div>
  <div class="body">
    <div class="center"><div class="cat">Sleep · 3 of 5</div><div class="dp">Hours slept</div></div>
    <div class="biginput">7.5 <small>h</small></div>
    <div class="dots"><span class="on"></span><span></span><span></span><span></span><span></span></div>
    <p style="text-align:center;color:var(--ink-mut);font-size:13px;margin-top:14px">Swipe or tap Next for each datapoint</p>
  </div>
  <div class="navrow"><div class="btn ghost">Skip</div><div class="btn primary">Next →</div></div>`,

"04 · charts": `${sb}
  <div class="apphead"><span class="wordmark">Charts</span><span class="spacer"></span><div class="iconbtn">＋</div></div>
  <div class="body"><div class="scroll">
    <div class="seg"><div class="on">📊 Sleep</div><div>📅 30d</div><div>⧗ Daily</div></div>
    <div class="chartcard">
      <div class="ct"><span class="nm">Hours slept</span><span class="rg">last 30 days</span></div>
      <svg viewBox="0 0 250 130" width="100%" height="150" preserveAspectRatio="none">
        <defs><linearGradient id="ga" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="var(--chart)" stop-opacity="0.22"/>
          <stop offset="1" stop-color="var(--chart)" stop-opacity="0"/></linearGradient></defs>
        <g stroke="var(--line)" stroke-width="1">
          <line x1="26" y1="14" x2="250" y2="14"/><line x1="26" y1="52" x2="250" y2="52"/><line x1="26" y1="90" x2="250" y2="90"/></g>
        <g fill="var(--ink-mut)" font-size="9" font-family="sans-serif"><text x="4" y="18">9</text><text x="4" y="56">7</text><text x="4" y="94">5</text></g>
        <path d="M32,92 66,60 100,34 134,58 168,42 202,66 236,50 L236,118 L32,118 Z" fill="url(#ga)"/>
        <polyline fill="none" stroke="var(--chart)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" points="32,92 66,60 100,34 134,58 168,42 202,66 236,50"/>
        <circle cx="236" cy="50" r="4" fill="var(--chart)" stroke="var(--card)" stroke-width="2"/>
        <g fill="var(--ink-mut)" font-size="8" font-family="sans-serif"><text x="28" y="128">Jun 12</text><text x="200" y="128">Jul 12</text></g>
      </svg>
    </div>
    <div class="card" style="margin-top:12px"><div class="prow"><span class="lead"><div class="t">Average</div></span><span class="big">7.1<span class="unit"> h</span></span></div>
      <div class="prow"><span class="lead"><div class="t">Best</div></span><span class="big">8.4<span class="unit"> h</span></span></div></div>
  </div></div>
  ${tab('c')}`,

"05 · settings home": `${sb}
  <div class="stackhead"><span class="back">‹</span><span class="title">Settings</span></div>
  <div class="body"><div class="scroll">
    <div class="sectitle">General</div>
    <div class="card"><div class="prow"><span class="ic">◐</span><span class="lead"><div class="t">Appearance</div></span><span class="val">System</span><span class="chev">›</span></div></div>
    <div class="sectitle">Input</div>
    <div class="card">
      <div class="prow"><span class="ic">◇</span><span class="lead"><div class="t">Categories</div></span><span class="chev">›</span></div>
      <div class="prow"><span class="ic">⦿</span><span class="lead"><div class="t">Datapoints</div></span><span class="chev">›</span></div></div>
    <div class="sectitle">Charts</div>
    <div class="card"><div class="prow"><span class="ic">▤</span><span class="lead"><div class="t">Charts</div></span><span class="chev">›</span></div></div>
    <div class="sectitle">Notifications</div>
    <div class="card"><div class="prow"><span class="ic">🔔</span><span class="lead"><div class="t">Notifications</div></span><span class="val">3 active</span><span class="chev">›</span></div></div>
    <div class="sectitle">Account</div>
    <div class="card"><div class="prow"><span class="ic" style="background:var(--act-soft);color:var(--act)">🗑</span><span class="lead"><div class="t" style="color:var(--act)">Delete account</div></span></div></div>
  </div></div>`,

"06 · settings list": `${sb}
  <div class="stackhead"><span class="back">‹</span><span class="title">Datapoints</span><span class="spacer"></span><div class="plus">＋</div></div>
  <div class="body"><div class="scroll">
    <div class="sectitle">Sleep</div>
    <div class="card">
      <div class="prow"><span class="ic">🌙</span><span class="lead"><div class="t">Hours slept</div><div class="s">Number · h</div></span><span class="chev">›</span></div>
      <div class="prow"><span class="ic">✦</span><span class="lead"><div class="t">Sleep quality</div><div class="s">Rating · 1–5</div></span><span class="chev">›</span></div></div>
    <div class="sectitle">Mood</div>
    <div class="card">
      <div class="prow"><span class="ic">☺</span><span class="lead"><div class="t">Overall mood</div><div class="s">Rating · 1–5</div></span><span class="chev">›</span></div>
      <div class="prow"><span class="ic">⚡</span><span class="lead"><div class="t">Energy</div><div class="s">Number · /10</div></span><span class="chev">›</span></div></div>
  </div></div>`,

"07 · settings one": `${sb}
  <div class="stackhead"><span class="back">‹</span><span class="title">Edit datapoint</span><span class="spacer"></span><span class="save">Save</span></div>
  <div class="body"><div class="scroll">
    <div class="label">Name</div><div class="field focus">Hours slept</div>
    <div class="label">Category</div><div class="field">Sleep <span class="ph">▾</span></div>
    <div class="label">Type</div>
    <div class="seg" style="margin-top:7px"><div>Binary</div><div class="on">Number</div><div>Rating</div><div>Text</div></div>
    <div class="label">Unit</div><div class="field">h</div>
    <div class="btn primary">Save changes</div>
    <div class="btn danger">Delete datapoint</div>
  </div></div>`,
};

const g=document.getElementById('g');
for(const[l,h]of Object.entries(S)){const w=document.createElement('div');w.className='frame-wrap';
  w.innerHTML=`<div class="device"><div class="notch"></div><div class="screen">${h}</div></div><div class="frame-label">${l}</div>`;g.appendChild(w);}
function tm(){const r=document.documentElement;const n=r.getAttribute('data-mode')=='light'?'dark':'light';r.setAttribute('data-mode',n);document.getElementById('mb').textContent=n=='light'?'◐ Dark':'◑ Light';}
</script>
</body>
</html>
