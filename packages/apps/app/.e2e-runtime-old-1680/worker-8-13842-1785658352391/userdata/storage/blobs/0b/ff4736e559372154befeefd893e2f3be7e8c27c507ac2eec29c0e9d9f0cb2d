---
title: "Server tick — time-based decay/momentum band changes as events"
---
flowchart TD
  CRON["Effect Schedule.fixed(~hourly)<br/>in-process on AppRuntime, supervised"]
  CRON --> SCAN["for each org (SELECT DISTINCT org_id):<br/>load non-terminal Deals  FOR UPDATE"]
  SCAN --> COMP["compute current band via pure<br/>decay() / momentum() (same fns + params as read-time)"]
  COMP --> CMP{"current band != stored<br/>state.__bands[field] ?"}
  CMP -->|no| SKIP["no-op — idempotent<br/>(no event, no notify storm)"]
  CMP -->|yes| EV["append ComputedBandChanged {field, from, to}<br/>fold -> state.__bands[field]=to, version+1<br/>(actor = system:decay-tick)"]
  EV --> NOTIFY["pg_notify envelope<br/>eventType = ComputedBandChanged"]
  NOTIFY --> LIVE["same pipeline: SSE -> clients refetch<br/>owed + mounted hub<br/>(deal enters 'decaying' for EVERYONE, untouched)"]
  EV --> AUTO["first-class hook for future automations:<br/>notify owner / create task / webhook"]
  classDef good fill:#16351f,stroke:#3fb96a,color:#d7f5e0;
  class EV,LIVE good;
