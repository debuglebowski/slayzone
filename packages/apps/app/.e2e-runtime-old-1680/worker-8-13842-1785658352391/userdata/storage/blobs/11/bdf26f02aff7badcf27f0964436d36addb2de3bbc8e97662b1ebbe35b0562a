<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Particle Field</title>
<style>
  html, body { margin: 0; height: 100%; background: #05060a; overflow: hidden; font-family: system-ui, sans-serif; color: #cbd5e1; }
  canvas { display: block; width: 100%; height: 100%; cursor: crosshair; }
  .panel { position: fixed; top: 1rem; left: 1rem; background: rgba(15, 23, 42, 0.85); padding: 1rem 1.25rem; border-radius: 10px; backdrop-filter: blur(8px); border: 1px solid #1e293b; }
  .panel h1 { margin: 0 0 0.5rem; font-size: 1rem; }
  .panel label { display: block; font-size: 0.8rem; margin-top: 0.5rem; color: #94a3b8; }
  .panel input[type=range] { width: 180px; }
  .panel button { margin-top: 0.75rem; background: #3b82f6; color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 5px; cursor: pointer; font-size: 0.85rem; }
  .stats { position: fixed; bottom: 1rem; right: 1rem; font-size: 0.8rem; background: rgba(15, 23, 42, 0.85); padding: 0.5rem 0.85rem; border-radius: 6px; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div class="panel">
  <h1>Particle Field</h1>
  <label>Particles: <span id="countLabel">180</span></label>
  <input id="count" type="range" min="20" max="500" value="180">
  <label>Link distance: <span id="distLabel">120</span></label>
  <input id="dist" type="range" min="40" max="240" value="120">
  <label>Speed: <span id="spdLabel">1.0</span></label>
  <input id="spd" type="range" min="1" max="40" value="10">
  <button id="reset">Reset</button>
  <button id="burst">Burst @ cursor</button>
</div>
<div class="stats">FPS: <span id="fps">--</span></div>
<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
let W = 0, H = 0;
function resize() { W = canvas.width = innerWidth; H = canvas.height = innerHeight; }
addEventListener('resize', resize); resize();

const mouse = { x: -1e6, y: -1e6, down: false };
canvas.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
canvas.addEventListener('mouseleave', () => { mouse.x = -1e6; mouse.y = -1e6; });
canvas.addEventListener('mousedown', () => mouse.down = true);
canvas.addEventListener('mouseup', () => mouse.down = false);

let particles = [];
let cfg = { count: 180, dist: 120, spd: 1.0 };

function rand(a, b) { return a + Math.random() * (b - a); }
function makeP(x, y, vx, vy) {
  return { x: x ?? rand(0, W), y: y ?? rand(0, H), vx: vx ?? rand(-1, 1), vy: vy ?? rand(-1, 1), r: rand(1.2, 2.6), hue: rand(190, 280) };
}
function rebuild() { particles = Array.from({ length: cfg.count }, () => makeP()); }
rebuild();

const countEl = document.getElementById('count'), distEl = document.getElementById('dist'), spdEl = document.getElementById('spd');
const cl = document.getElementById('countLabel'), dl = document.getElementById('distLabel'), sl = document.getElementById('spdLabel');
countEl.oninput = () => { cfg.count = +countEl.value; cl.textContent = cfg.count; rebuild(); };
distEl.oninput = () => { cfg.dist = +distEl.value; dl.textContent = cfg.dist; };
spdEl.oninput = () => { cfg.spd = +spdEl.value / 10; sl.textContent = cfg.spd.toFixed(1); };
document.getElementById('reset').onclick = rebuild;
document.getElementById('burst').onclick = () => {
  if (mouse.x < 0) return;
  for (let i = 0; i < 40; i++) {
    const a = (i / 40) * Math.PI * 2;
    particles.push(makeP(mouse.x, mouse.y, Math.cos(a) * 4, Math.sin(a) * 4));
  }
};

let last = performance.now(), frames = 0, fpsTime = 0, fpsEl = document.getElementById('fps');
function tick(now) {
  const dt = Math.min(33, now - last); last = now;
  frames++; fpsTime += dt;
  if (fpsTime > 500) { fpsEl.textContent = (frames * 1000 / fpsTime).toFixed(0); frames = 0; fpsTime = 0; }

  ctx.fillStyle = 'rgba(5, 6, 10, 0.25)';
  ctx.fillRect(0, 0, W, H);

  for (const p of particles) {
    p.x += p.vx * cfg.spd; p.y += p.vy * cfg.spd;
    if (p.x < 0 || p.x > W) p.vx *= -1;
    if (p.y < 0 || p.y > H) p.vy *= -1;
    if (mouse.x > 0) {
      const dx = p.x - mouse.x, dy = p.y - mouse.y, d2 = dx*dx + dy*dy;
      if (d2 < 22500) {
        const f = (mouse.down ? -1 : 1) * 0.05 / Math.max(20, Math.sqrt(d2));
        p.vx += dx * f; p.vy += dy * f;
      }
    }
    p.vx *= 0.995; p.vy *= 0.995;
  }

  for (let i = 0; i < particles.length; i++) {
    for (let j = i + 1; j < particles.length; j++) {
      const a = particles[i], b = particles[j];
      const dx = a.x - b.x, dy = a.y - b.y, d = Math.sqrt(dx*dx + dy*dy);
      if (d < cfg.dist) {
        const alpha = 1 - d / cfg.dist;
        ctx.strokeStyle = `hsla(${(a.hue + b.hue) / 2}, 70%, 60%, ${alpha * 0.4})`;
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
      }
    }
  }

  for (const p of particles) {
    ctx.fillStyle = `hsl(${p.hue}, 80%, 65%)`;
    ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
  }

  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);
</script>
</body>
</html>
