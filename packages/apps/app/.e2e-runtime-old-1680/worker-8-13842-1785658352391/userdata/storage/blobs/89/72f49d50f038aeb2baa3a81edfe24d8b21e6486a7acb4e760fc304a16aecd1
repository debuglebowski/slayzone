<!doctype html>
<html><head><meta charset="utf-8"><style>
*{box-sizing:border-box;margin:0;padding:0}
body{font:13px/1.45 -apple-system,system-ui,sans-serif;color:#18181b;background:#f4f4f5;padding:28px}
.caption{max-width:960px;margin:0 auto 10px;color:#52525b;font-size:12px}
.caption b{color:#18181b}
.app{max-width:960px;margin:0 auto;background:#fff;border:1px solid #e4e4e7;border-radius:10px;box-shadow:0 1px 2px rgba(0,0,0,.04);position:relative}
.titlebar{padding:14px 18px;border-bottom:1px solid #ececef;display:flex;align-items:center;gap:10px}
h1{font-size:15px;font-weight:600}
.count{color:#9ca3af;font-size:12px}
.barwrap{padding:10px 18px;border-bottom:1px solid #ececef;background:#fcfcfd;position:relative}
.qbar{display:flex;align-items:center;gap:6px;border:1px solid #c7d4f8;border-radius:8px;padding:7px 10px;background:#fff;box-shadow:0 0 0 3px #eef2fe}
.qbar .icon{color:#a1a1aa}
.tok{display:inline-flex;align-items:center;border:1px solid #dbe3f8;background:#eef2fe;border-radius:5px;font-size:12px;overflow:hidden}
.tok .k{padding:2px 6px;color:#6477b8;background:#e3eafc;font-weight:500}
.tok .v{padding:2px 7px;color:#3b4f9e}
.caret{width:1.5px;height:15px;background:#18181b;animation:b 1s steps(1) infinite}
@keyframes b{50%{opacity:0}}
.hint{margin-left:auto;font-size:11px;color:#a1a1aa}
.ac{position:absolute;left:18px;top:56px;width:330px;background:#fff;border:1px solid #e4e4e7;border-radius:9px;box-shadow:0 8px 24px rgba(0,0,0,.13);padding:6px;z-index:5}
.ac .h{font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;color:#a1a1aa;padding:4px 8px}
.ac .it{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;font-size:12.5px;color:#3f3f46}
.ac .it.on{background:#f4f4f5}
.ac .it .t{color:#a1a1aa;font-size:11px;margin-left:auto}
.kbd{border:1px solid #e4e4e7;border-bottom-width:2px;border-radius:4px;padding:0 4px;font-size:10px;color:#71717a;background:#fafafa}
table{width:100%;border-collapse:collapse}
th{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#71717a;text-align:left;padding:8px 14px;border-bottom:1px solid #ececef;background:#fafafa;font-weight:500}
td{padding:9px 14px;border-bottom:1px solid #f1f1f4}
.pill{display:inline-block;padding:1px 8px;border-radius:999px;font-size:11.5px;font-weight:500}
.active{background:#dcfce7;color:#166534}
</style></head><body>
<div class="caption"><b>Layout 5 — Query token bar</b> (GitHub/Height style). One omnibar; typing autocompletes field → op → value into structured tokens (still `FilterCondition[]` underneath, not free text). Fastest for keyboard users, least discoverable; plain words fall back to text search.</div>
<div class="app">
  <div class="titlebar"><h1>Deals</h1><span class="count">3 of 7 shown</span></div>
  <div class="barwrap">
    <div class="qbar">
      <span class="icon">⌕</span>
      <span class="tok"><span class="k">status</span><span class="v">Active</span></span>
      <span class="tok"><span class="k">amount</span><span class="v">&gt; 50k</span></span>
      <span class="tok"><span class="k">label</span><span class="v">priority</span></span>
      <span class="caret"></span>
      <span class="hint"><span class="kbd">↹</span> complete · <span class="kbd">⏎</span> apply</span>
    </div>
    <div class="ac">
      <div class="h">Filter by field</div>
      <div class="it on">📅 close date <span class="t">before · after · between</span></div>
      <div class="it">👤 owner <span class="t">is · is me · any of</span></div>
      <div class="it">⬜ archived <span class="t">include</span></div>
      <div class="h">Plain text</div>
      <div class="it">⌕ search "clo" in all fields</div>
    </div>
  </div>
  <table>
    <tr><th>Name</th><th>Status</th><th>Amount</th><th>Close date</th><th>Owner</th></tr>
    <tr><td>Acme renewal</td><td><span class="pill active">Active</span></td><td>$82,000</td><td>Jul 1, 2026</td><td>Mia</td></tr>
    <tr><td>Globex expansion</td><td><span class="pill active">Active</span></td><td>$54,500</td><td>Jun 18, 2026</td><td>Theo</td></tr>
    <tr><td>Umbrella upsell</td><td><span class="pill active">Active</span></td><td>$61,200</td><td>Aug 9, 2026</td><td>Ravi</td></tr>
  </table>
</div>
</body></html>
