{
  "expo": {
    "name": "SlayZone",
    "slug": "slayzone-mobile",
    "scheme": "slayzone",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "updates": { "enabled": false },
    "ios": {
      "bundleIdentifier": "com.slayzone.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "SlayZone uploads the photos you pick to a task's artifacts.",
          "cameraPermission": "SlayZone uploads the photos you take to a task's artifacts.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-artifact-page-assets"
    ]
  }
}
