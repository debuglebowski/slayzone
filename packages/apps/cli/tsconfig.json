{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "paths": {
      "*": ["./*"],
      "@slayzone/projects-contracts": ["../../domains/projects-contracts/src/index.ts"],
      "@slayzone/terminal-contracts": ["../../domains/terminal-contracts/src/index.ts"],
      "@slayzone/task-contracts/types": ["../../domains/task-contracts/src/types.ts"],
      "@slayzone/ai-config/shared": ["../../domains/ai-config/src/shared/index.ts"],
      "@slayzone/automations/shared": ["../../domains/automations/src/shared/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
