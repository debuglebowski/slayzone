{
  "name": "slayzone-monorepo",
  "private": true,
  "license": "GPL-3.0-only",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "posix"
    ],
    "overrides": {
      "zod": "^4.5.4",
      "d3-shape>d3-path": "^3.1.0",
      "node-abi": "^4.35.0",
      "posix>nan": "^2.29.0",
      "electron-chrome-web-store>adm-zip": "^0.6.1",
      "prosemirror-view": "^1.42.3",
      "prosemirror-model": "^1.25.12"
    },
    "patchedDependencies": {
      "@convex-dev/auth@0.0.95": "patches/@convex-dev__auth@0.0.95.patch",
      "posix@4.2.0": "patches/posix@4.2.0.patch",
      "@radix-ui/react-menu@2.1.24": "patches/@radix-ui__react-menu@2.1.24.patch",
      "electron-chrome-extensions@4.9.0": "patches/electron-chrome-extensions@4.9.0.patch",
      "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
    }
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev": "pnpm --filter @slayzone/app dev",
    "dev:protocol": "pnpm --filter @slayzone/app dev:protocol",
    "dev:chromium": "pnpm build:chromium && pnpm run:chromium",
    "build:chromium": "pnpm --filter @slayzone/hub build && pnpm --filter @slayzone/chromium-shell build",
    "run:chromium": "scripts/chromium/run.sh -- about:blank",
    "generate-icons": "node scripts/generate-icons.js",
    "patch-electron-name": "node scripts/patch-electron-name.js",
    "reset-mac-icon-cache": "bash scripts/reset-mac-icon-cache.sh",
    "build": "pnpm --filter @slayzone/app build",
    "build:mac": "pnpm --filter @slayzone/app build:mac",
    "build:win": "pnpm --filter @slayzone/app build:win",
    "build:win:x64": "pnpm --filter @slayzone/app build:win:x64",
    "build:win:arm64": "pnpm --filter @slayzone/app build:win:arm64",
    "build:win:all": "pnpm --filter @slayzone/app build:win:all",
    "build:linux": "pnpm --filter @slayzone/app build:linux",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:versions && pnpm lint:theme && pnpm lint:server-boundary && pnpm lint:trpc-deps && pnpm lint:window-api && pnpm lint:e2e-guardrails && pnpm lint:react-compiler && pnpm lint:format && pnpm lint:biome && pnpm lint:eslint && pnpm test:unit:registered",
    "audit:check": "node scripts/ci/audit-check.mjs",
    "audit:age": "node scripts/ci/release-age-check.mjs",
    "lint:versions": "node scripts/sync-versions.mjs --check",
    "sync-versions": "node scripts/sync-versions.mjs",
    "lint:server-boundary": "bash scripts/check-server-electron-free.sh && node scripts/check-hub-exec-imports.mjs",
    "lint:trpc-deps": "bash scripts/check-trpc-stable-deps.sh",
    "lint:window-api": "bash scripts/check-renderer-window-api.sh",
    "lint:e2e-guardrails": "node scripts/check-e2e-guardrails.mjs",
    "lint:react-compiler": "node scripts/check-react-compiler.mjs",
    "lint:deps": "knip --include dependencies,unlisted",
    "lint:biome": "biome lint .",
    "lint:format": "NODE_OPTIONS=--max-old-space-size=8192 biome format .",
    "lint:eslint": "eslint . --max-warnings=134",
    "lint:theme": "bash scripts/lint-theme.sh",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test:unit": "bash packages/shared/test-utils/run-all.sh",
    "test:unit:registered": "SLZ_UNIT_DRY=1 bash packages/shared/test-utils/run-all.sh",
    "test:chat:perf": "npx tsx packages/domains/task-terminals/src/client/chat/__perf__/baseline.test.ts",
    "test:e2e": "pnpm --filter @slayzone/app test:e2e",
    "test:e2e:browser-modified-link": "pnpm --filter @slayzone/app exec playwright test --config playwright.config.ts e2e/browser/24-browser-panel.spec.ts -g \"prefilled task draft\" --repeat-each=5",
    "test:e2e:loop": "pnpm --filter @slayzone/app test:e2e:loop",
    "test:e2e:loop:stop": "pnpm --filter @slayzone/app test:e2e:loop:stop",
    "changelog": "changelogen --output CHANGELOG.md --hideAuthorEmail",
    "release:patch": "pnpm --filter @slayzone/app exec npm version patch && pnpm release:tag",
    "release:minor": "pnpm --filter @slayzone/app exec npm version minor && pnpm release:tag",
    "release:major": "pnpm --filter @slayzone/app exec npm version major && pnpm release:tag",
    "release:tag": "bash scripts/tag-release.sh",
    "release:beta": "node scripts/release/cut-beta.mjs",
    "build:website": "pnpm --filter @slayzone/website build",
    "dev:website": "pnpm --filter @slayzone/website dev"
  },
  "devDependencies": {
    "@auth/core": "^0.41.3",
    "@biomejs/biome": "2.5.14",
    "@convex-dev/auth": "^0.0.95",
    "@slayzone/tsgo": "workspace:*",
    "@types/node": "^22.19.7",
    "changelogen": "^0.6.2",
    "convex": "^1.46.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "6.38.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.34.5"
  },
  "version": "0.36.0",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
